"""The rand capability: versioned seeded streams (17.3, 7.1). `next_u64` is the primitive; std
derives every other operation from it with a fixed algorithm, so a seed gives the same values
under every handler and implementation."""

@since("1.0")
pub type Algorithm = ChaCha8() | Pcg64Dxsm()

@capability
@since("1.0")
pub trait Rand:
    def next_u64(self: Self) -> uint64: ...
    def next_f64(self: Self) -> float: ...
    def below(self: Self, n: int) -> int: ...
    def range(self: Self, lo: int, hi: int) -> int: ...
    def bool(self: Self) -> bool: ...
    def choice[T](self: Self, xs: list[T]) -> T: ...
    def shuffle[T](self: Self, var xs: list[T]) -> None: ...
