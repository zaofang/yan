"""The log capability: structured events and spans (17.3, 7.1). `log.info(msg, key=value)` and
its siblings lower to `event`, with each keyword argument a field holding `show(value)`;
`log.span(name, key=value)` returns a child handler for `with log = ...`."""

@since("1.0")
pub type Level = DebugLevel() | InfoLevel() | WarnLevel() | ErrorLevel()

@capability
@since("1.0")
pub trait Log:
    def event(self: Self, level: Level, msg: str, fields: list[tuple[str, str]]) -> None: ...
    def span(self: Self, name: str, fields: list[tuple[str, str]]) -> Log: ...
