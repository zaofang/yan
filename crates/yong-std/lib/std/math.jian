"""Correctly rounded math (11.1, 17.3). Every function is tier E. Domain errors give the IEEE
result (NaN or an infinity), never a panic."""

@since("1.0")
pub type Round = NearestEven() | Up() | Down() | TowardZero()

@since("1.0")
pub pi: float = 3.141592653589793

@since("1.0")
pub e: float = 2.718281828459045

@since("1.0")
pub inf: float = 1e999

@since("1.0")
pub nan: float = 1e999 - 1e999

@intrinsic
@since("1.0")
pub def add(a: float, b: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def sub(a: float, b: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def mul(a: float, b: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def div(a: float, b: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def fma(a: float, b: float, c: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def sqrt(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def sum_exact(xs: list[float], round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def dot_exact(xs: list[float], ys: list[float], round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def exp(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def exp2(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def exp10(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def expm1(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def exp2m1(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def exp10m1(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def log(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def log2(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def log10(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def log1p(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def log2p1(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def log10p1(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def cbrt(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def rsqrt(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def sin(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def cos(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def tan(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def sinpi(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def cospi(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
