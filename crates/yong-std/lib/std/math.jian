pub def atan2pi(y: float, x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def pown(x: float, n: int, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def floor(x: float) -> float: ...

@intrinsic
@since("1.0")
pub def ceil(x: float) -> float: ...

@intrinsic
@since("1.0")
pub def trunc(x: float) -> float: ...

