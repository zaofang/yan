@since("1.0")
pub def asinpi(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def acospi(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def atanpi(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def sinh(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def cosh(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def tanh(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def asinh(x: float, round: Round = NearestEven()) -> float: ...

