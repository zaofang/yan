@since("1.0")
pub def lgamma(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def tgamma(x: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def pow(x: float, y: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
pub def powr(x: float, y: float, round: Round = NearestEven()) -> float: ...

