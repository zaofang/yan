"""The env capability: arguments, variables, secrets and the local zone (17.3, 7.1). There is no
`set_var`: the environment is shared, and mutating it races with every reader."""

@capability
@since("1.0")
pub trait Env:
    def args(self: Self) -> list[str]: ...
    def var(self: Self, name: str) -> str | None: ...
    def vars(self: Self) -> dict[str, str]: ...
    def secret(self: Self, name: str) -> Secret[str] | None: ...
    def local_zone(self: Self) -> TimeZone: ...
    def only(self: Self, vars: list[str]) -> Env: ...

@intrinsic
@since("1.0")
pub def expose[T](self: Secret[T]) -> T: ...
