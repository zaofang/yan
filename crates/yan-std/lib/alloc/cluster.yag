"""The cluster capability (7, 9.6.1, R400): the nodes a program runs on and the calls through
`Remote` between them (RFC 0063). `reach` is the lowering of a handler call through
`Remote[Actor[S, P]]`, and `place` and `leave` of `cluster.spawn`, and `wire` of the encode and decode a call through
`Remote` makes of its arguments and result (R402), not for direct use."""

@since("1.0")
@derive(Wire)
pub class Node:
    """A node (R403): its id, shown as 32 hex digits."""
    id: str

@since("1.0")
pub type Placement = Local() | On(node: Node) | Spread() | ByKey(key: bytes) | Near(node: Node)

@since("1.0")
pub class Unreachable:
    """A message to or from another node was lost or cut off by a partition (R408)."""
    pass

@since("1.0")
pub class Rejected:
    """The receiving node refused the call (R408)."""
    pass

@since("1.0")
pub class SchemaMismatch:
    """The receiving node's `Wire` schema for the call differs (R408)."""
    pass

@since("1.0")
pub type RemoteError = Stopped | Timeout | Cancelled | Deadlock | Unreachable | Rejected | SchemaMismatch

@capability
@since("1.0")
pub trait Cluster:
    def nodes(self: Self) -> list[Node]: ...
    def self_node(self: Self) -> Node: ...


@intrinsic
@since("1.0")
pub def reach[S, P](self: Remote[Actor[S, P]]) -> Actor[S, P]: ...

@intrinsic
@since("1.0")
pub def arrive[T, F](outcome: Result[T, F]) -> Result[T, F]: ...

@intrinsic
@since("1.0")
pub def admit[F]() -> Result[None, F]: ...

@intrinsic
@since("1.0")
pub def monitor[S, P, D](cluster: Cluster, target: Remote[Actor[S, P]]) -> Receiver[D]: ...

@intrinsic
@since("1.0")
pub def group[A](cluster: Cluster, name: str) -> Group[A]: ...

@intrinsic
@since("1.0")
pub def place(cluster: Cluster, node: Node) -> None: ...

@intrinsic
@since("1.0")
pub def leave() -> None: ...

@intrinsic
@since("1.0")
pub def wire_reply[T](x: T, schema: str) -> T: ...

@intrinsic
@since("1.0")
pub def wire[T](x: T, schema: str) -> T: ...

@intrinsic
@since("1.0")
pub def commit[T](var dst: T, src: T) -> None: ...

@intrinsic
@since("1.0")
pub def wire_start[T](x: T, schema: str) -> T: ...

@intrinsic
@since("1.0")
pub def wire_send[T](x: T, schema: str) -> T: ...

@intrinsic
@since("1.0")
pub def handle[S, P](self: Remote[Actor[S, P]]) -> Actor[S, P]: ...

@intrinsic
@since("1.0")
pub def fault_send[S, P](self: Remote[Actor[S, P]]) -> None: ...
