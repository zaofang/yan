"""Methods on sorted_set, in ascending order (17.3, R488 to R493)."""

@intrinsic
@since("1.0")
pub def add[T: Ord](var self: sorted_set[T], take x: T) -> None: ...

@intrinsic
@since("1.0")
pub def discard[T: Ord](var self: sorted_set[T], x: T) -> None: ...

@intrinsic
@since("1.0")
pub def contains[T: Ord](self: sorted_set[T], x: T) -> bool: ...

@intrinsic
@since("1.0")
pub def len[T: Ord](self: sorted_set[T]) -> int: ...

@intrinsic
@since("1.0")
pub def union[T: Ord](self: sorted_set[T], other: sorted_set[T]) -> sorted_set[T]: ...

@intrinsic
@since("1.0")
pub def intersection[T: Ord](self: sorted_set[T], other: sorted_set[T]) -> sorted_set[T]: ...

@intrinsic
@since("1.0")
pub def first[T: Ord](self: sorted_set[T]) -> T | None: ...

@intrinsic
@since("1.0")
pub def last[T: Ord](self: sorted_set[T]) -> T | None: ...

@intrinsic
@since("1.0")
pub def pop_first[T: Ord](var self: sorted_set[T]) -> T | None: ...

@intrinsic
@since("1.0")
pub def pop_last[T: Ord](var self: sorted_set[T]) -> T | None: ...

@intrinsic
@since("1.0")
pub def floor[T: Ord](self: sorted_set[T], x: T) -> T | None: ...

@intrinsic
@since("1.0")
pub def ceiling[T: Ord](self: sorted_set[T], x: T) -> T | None: ...

@intrinsic
@since("1.0")
pub def range[T: Ord](self: sorted_set[T], lo: T, hi: T) -> list[T]: ...

@intrinsic
@since("1.0")
pub def iter[T: Ord](self: sorted_set[T]) -> iter[T]: ...
