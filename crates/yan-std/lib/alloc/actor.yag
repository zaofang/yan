"""Actors (9.6, 17.3): `Actor[S, P]` owns state `S` and has overflow policy `P`; a handle reaches
other nodes as `Remote`. `take`, `put`, `settle`, `reply`, `send`, `spawn_as` and `start` are the
lowering of a handler call `h.f(args)` (R435), of `actor.send(h).f(args)` (R813), of
`actor.spawn(state)` (R956) and of `actor.start(ChildSpec(f, (args...), restart=r))` (R958), and
`lend` and `retake` of a `@reentrant` handler's suspensions (9.6), not for direct use. `F` is the
call's fail type: the handler's own plus `ActorError`, or `Undelivered[A, R]` for a send. `policy`
is `P` as 0 `Block`, 1 `DropOldest`, 2 `DropNew`, 3 `Reject`."""

@since("1.0")
pub class Block:
    """The default overflow policy (R974): a send to a full mailbox waits for space."""
    pass

@since("1.0")
pub class DropOldest:
    """An overflow policy (R974): a send to a full mailbox drops its oldest message."""
    pass

@since("1.0")
pub class DropNew:
    """An overflow policy (R974): a send to a full mailbox drops the new message."""
    pass

@since("1.0")
pub class Reject:
    """An overflow policy (R974): a send to a full mailbox fails `Full`."""
    pass

@since("1.0")
pub class Full:
    """Why a send to a full `Reject` mailbox failed (R976)."""
    pass

@intrinsic
@since("1.0")
pub def share[S, P](self: Actor[S, P]) -> Remote[Actor[S, P]]: ...

@intrinsic
@since("1.0")
pub def send_only[S, P](self: Actor[S, P]) -> SendOnly[S, P]: ...

@intrinsic
@since("1.0")
pub def spawn[S](state: S, capacity: int = 1024) -> Actor[S]: ...

@intrinsic
@since("1.0")
pub def spawn_as[S, P](state: S, capacity: int, policy: int) -> Actor[S, P]: ...

@intrinsic
@since("1.0")
pub def take[S, P, F](self: Actor[S, P]) -> Result[S, F]: ...

@intrinsic
@since("1.0")
pub def put[S, P](self: Actor[S, P], state: S) -> None: ...

@intrinsic
@since("1.0")
pub def settle[S, P, T, E, F](self: Actor[S, P], state: S, outcome: Result[T, E]) -> Result[T, F]: ...

@intrinsic
@since("1.0")
pub def lend[S, P](self: Actor[S, P], var state: S) -> int: ...

@intrinsic
@since("1.0")
pub def retake[S, P, F](self: Actor[S, P], since: int, var state: S) -> None fail F: ...

@intrinsic
@since("1.0")
pub def reply[T, F](outcome: Result[T, F]) -> T fail F: ...

@intrinsic
@since("1.0")
pub def send[S, P, A, F](self: Actor[S, P], args: A, message: Callable[[A], None]) -> None fail F: ...

@since("1.0")
pub type Strategy = OneForOne() | OneForAll() | RestForOne()

@since("1.0")
pub class Supervisor:
    """A supervisor spec (9.6): its strategy, at most `intensity` restarts per `period`, and each
    child's `shutdown` timeout. `with supervisor(spec):` binds it for the actors started inside."""
    strategy: Strategy
    intensity: int
    period: Duration
    shutdown: Duration

@intrinsic
@since("1.0")
pub def one_for_one(intensity: int = 1, period: Duration = 5 * s, shutdown: Duration = 5 * s) -> Supervisor: ...

@intrinsic
@since("1.0")
pub def one_for_all(intensity: int = 1, period: Duration = 5 * s, shutdown: Duration = 5 * s) -> Supervisor: ...

@intrinsic
@since("1.0")
pub def rest_for_one(intensity: int = 1, period: Duration = 5 * s, shutdown: Duration = 5 * s) -> Supervisor: ...

@intrinsic
@since("1.0")
pub def start[S, P](start: Callable[[], S], restart: int, capacity: int, policy: int) -> Actor[S, P]: ...
