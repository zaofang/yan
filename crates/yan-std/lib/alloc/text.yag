@since("1.0")
pub def split(self: str, sep: str | None = None) -> list[str]: ...

@intrinsic
@since("1.0")
pub def join(self: str, parts: list[str]) -> str: ...

@intrinsic
@since("1.0")
pub def splitlines(self: str) -> list[str]: ...

@intrinsic
@since("1.0")
pub def partition(self: str, sep: str) -> tuple[str, str, str]: ...

