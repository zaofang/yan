@intrinsic
@since("1.0")
pub def is_digit(self: char) -> bool: ...

@intrinsic
@since("1.0")
pub def is_alpha(self: char) -> bool: ...

@intrinsic
@since("1.0")
pub def is_alnum(self: char) -> bool: ...

@intrinsic
@since("1.0")
pub def is_upper(self: char) -> bool: ...

@intrinsic
@since("1.0")
