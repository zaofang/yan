@since("1.0")
pub def parse_int(self: str) -> int | None: ...

@intrinsic
@since("1.0")
pub def parse_float(self: str) -> float | None: ...

@intrinsic
@since("1.0")
pub def iter(self: str) -> iter[char]: ...

@intrinsic
@since("1.0")
pub def chars(self: str) -> iter[char]: ...

@intrinsic
@since("1.0")
pub def bytes(self: str) -> bytes: ...

