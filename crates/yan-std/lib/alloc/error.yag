"""Failure glue: the Error type and context chains (8.1, R432)."""

@since("1.0")
pub class Error:
    """Any failure with `Show`, as its shown text, and its context chain, outermost first."""
    message: str
    context: list[str]

@intrinsic
@since("1.0")
pub def context[T, E: Show](take r: Result[T, E], msg: str) -> T fail Error: ...

@intrinsic
@since("1.0")
pub def wrap[E: Show](take e: E) -> Error: ...

@since("1.0")
pub class Cancelled:
    """The failure a blocking operation returns in a cancelled task (9.4)."""
    pass

@since("1.0")
pub class Timeout:
    """The failure of an operation whose deadline expired (9.4)."""
    pass

@since("1.0")
pub class Stopped:
    """The failure of a call to an actor that stopped before it ran the call, and why (9.6, R977)."""
    reason: StopReason

@since("1.0")
pub type StopReason = Normal() | Shutdown() | Crashed(error: str) | NodeDown()

@since("1.0")
pub class Deadlock:
    """The failure of the youngest caller in a cycle of waits (9.6)."""
    pass

@since("1.0")
pub type ActorError = Stopped | Timeout | Cancelled | Deadlock
