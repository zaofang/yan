"""The sending end of a channel. Send but not Sync; a second producer exists only through
`share`, which needs `uses nondet` (E709)."""

@intrinsic
@since("1.0")
pub def send[T](var self: Sender[T], take v: T) -> None fail Cancelled: ...

@intrinsic
@since("1.0")
pub def share[T](self: Sender[T]) -> Sender[T]: ...
