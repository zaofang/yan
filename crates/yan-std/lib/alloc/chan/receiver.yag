"""The receiving end of a channel."""

@intrinsic
@since("1.0")
pub def recv[T](var self: Receiver[T]) -> T | None fail Cancelled | Timeout: ...

@intrinsic
@since("1.0")
pub def try_recv[T](var self: Receiver[T]) -> T | None fail Empty | Cancelled: ...

@intrinsic
@since("1.0")
pub def share[T](self: Receiver[T]) -> Receiver[T]: ...
