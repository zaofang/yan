"""Channels (17.3, 6.5): `Channel[T](capacity)` returns a `Sender` and a `Receiver`."""

@intrinsic
@since("1.0")
pub def Channel[T](capacity: int) -> tuple[Sender[T], Receiver[T]]: ...

@since("1.0")
pub class Empty:
    """The failure of `try_recv` on an open channel with nothing queued (9.5)."""
    pass

@since("1.0")
pub class Full:
    """The failure of `try_send` on a channel with no room (9.5)."""
    pass
