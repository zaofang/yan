"""Channels (17.3, 6.5): `Channel[T](capacity)` returns a `Sender` and a `Receiver`."""

@intrinsic
@since("1.0")
pub def Channel[T](capacity: int) -> tuple[Sender[T], Receiver[T]]: ...

@since("1.0")
pub type TryRecv[T] = Got(value: T) | Empty() | Closed()

@since("1.0")
pub class Full[T]:
    """The failure of `try_send` on a channel with no room; `value` is the unsent payload (9.5)."""
    value: T
