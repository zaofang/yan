"""Names in scope in every module without an import (17.2)."""

@intrinsic
@since("1.0")
pub def sorted[T, K: Ord](xs: iter[T], key: Callable[[T], K] | None = None, reverse: bool = False) -> list[T]: ...

@intrinsic
@since("1.0")
pub def int(x: float) -> int: ...

@intrinsic
@since("1.0")
pub def float(x: int) -> float: ...

@intrinsic
@since("1.0")
pub def round(x: float) -> int: ...

@intrinsic
@since("1.0")
pub def abs[T: Num](x: T) -> T: ...

@intrinsic
@since("1.0")
pub def min[T, K: Ord](a: T, b: T, /, key: Callable[[T], K] | None = None) -> T: ...

@intrinsic
@since("1.0")
pub def max[T, K: Ord](a: T, b: T, /, key: Callable[[T], K] | None = None) -> T: ...

@intrinsic
@since("1.0")
pub def list[T](take xs: list[T]) -> list[T]: ...

@intrinsic
@since("1.0")
pub def deque[T](take xs: list[T] = [], maxlen: int | None = None) -> deque[T]: ...

@intrinsic
@since("1.0")
pub def heap[T: Ord](take xs: list[T] = []) -> heap[T]: ...

@intrinsic
@since("1.0")
pub def sorted_dict[K: Ord, V](take d: dict[K, V] = {}) -> sorted_dict[K, V]: ...

@intrinsic
@since("1.0")
pub def sorted_set[T: Ord](take xs: list[T] = []) -> sorted_set[T]: ...

@intrinsic
@since("1.0")
pub def range(start: int, stop: int | None = None, /) -> list[int]: ...

@intrinsic
@since("1.0")
pub def bigint(x: int) -> bigint: ...

@since("1.0")
pub def sum(xs: list[int]) -> int:
    ex sum([1, 2, 3]) == 6
    total = 0
    for x in xs:
        total += x
    return total

@since("1.0")
pub def any(xs: list[bool]) -> bool:
    ex any([False, True]) == True
    for x in xs:
        if x:
            return True
    return False

@since("1.0")
pub def all(xs: list[bool]) -> bool:
    ex all([True, False]) == False
    for x in xs:
        if not x:
            return False
    return True

@since("1.0")
pub def enumerate[T](xs: list[T]) -> list[tuple[int, T]]:
    ex enumerate(["a", "b"]) == [(0, "a"), (1, "b")]
    out: list[tuple[int, T]] = []
    i = 0
    for x in xs:
        out.append((i, x.copy()))
        i += 1
    return out

@since("1.0")
pub def zip[A, B](xs: list[A], ys: list[B]) -> list[tuple[A, B]]:
    ex zip([1, 2, 3], ["a", "b"]) == [(1, "a"), (2, "b")]
    out: list[tuple[A, B]] = []
    n = min(len(xs), len(ys))
    for i in range(n):
        out.append((xs[i].copy(), ys[i].copy()))
    return out

@since("1.0")
pub def reversed[T](xs: list[T]) -> list[T]:
    ex reversed([1, 2, 3]) == [3, 2, 1]
    out: list[T] = []
    n = len(xs)
    for i in range(n):
        out.append(xs[n - 1 - i].copy())
    return out

@intrinsic
@since("1.0")
pub def set[T: Hash](xs: iter[T]) -> set[T]: ...

@intrinsic
@since("1.0")
pub def dict[K: Hash, V](xs: iter[tuple[K, V]]) -> dict[K, V]: ...

@intrinsic
@since("1.0")
pub def bytearray() -> bytearray: ...

@intrinsic
@since("1.0")
pub def Path(s: str) -> Path: ...

@intrinsic
@since("1.0")
pub def WindowsPath(s: str) -> WindowsPath: ...

@intrinsic
@since("1.0")
pub def PlainDate(y: int, m: int, d: int) -> PlainDate: ...

@intrinsic
@since("1.0")
pub def PlainTime(h: int, mi: int, s: int = 0, ns: int = 0) -> PlainTime: ...

@intrinsic
@since("1.0")
pub def PlainDateTime(date: PlainDate, time: PlainTime) -> PlainDateTime: ...

@intrinsic
@since("1.0")
pub def Period(years: int = 0, months: int = 0, weeks: int = 0, days: int = 0) -> Period: ...

@intrinsic
@since("1.0")
pub def TimeZone(id: str) -> TimeZone: ...

@intrinsic
@since("1.0")
pub def Secret[T](take value: T) -> Secret[T]: ...

@intrinsic
@since("1.0")
pub def Command(program: str, args: list[str] = []) -> Command: ...

@since("1.0")
pub def int_pow(x: int, n: int) -> int:
    """`x ** n` on integers; overflow panics (14)."""
    pre n >= 0
    result = 1
    base = x
    e = n
    while e > 0:
        if e % 2 == 1:
            result *= base
        e //= 2
        if e > 0:
            base *= base
    return result

@since("1.0")
pub def fmt_pad(s: str, width: int, align: int, fill: str) -> str:
    """Pads `s` to `width` characters; `align` is 0 left, 1 right, 2 center (SQ20)."""
    gap = width - s.char_count()
    if gap <= 0:
        return s
    left = 0
    if align == 1:
        left = gap
    elif align == 2:
        left = gap // 2
    return fill * left + s + fill * (gap - left)
