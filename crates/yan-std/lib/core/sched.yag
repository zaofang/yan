"""The sched capability: the handler `par`, `par for` and `par concurrent` lower to (9.1)."""

@capability
@since("1.0")
pub trait Sched:
    def width(self: Self) -> int: ...

@intrinsic
@since("1.0")
pub def pool() -> Sched:
    """Fork-join over OS threads, one per core (9.1): parallel but not concurrent forward progress."""
    ...

@intrinsic
@concurrent
@since("1.0")
pub def sequential() -> Sched:
    """Cooperative on the current thread, switching at blocking operations to the lowest-index runnable task (9.1): deterministic and concurrent."""
    ...
