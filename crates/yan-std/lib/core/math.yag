"""Correctly rounded math (11.1, 17.3). Every function is tier E. Domain errors give the IEEE
result (NaN or an infinity), never a panic."""

@since("1.0")
pub type Round = NearestEven() | Up() | Down() | TowardZero()

@since("1.0")
pub pi: float = 3.141592653589793

@since("1.0")
pub e: float = 2.718281828459045

@since("1.0")
pub inf: float = 1e999

@since("1.0")
pub nan: float = 1e999 - 1e999

@intrinsic
@since("1.0")
pub def add(a: float, b: float, round: Round = NearestEven()) -> float: ...

@intrinsic
@since("1.0")
