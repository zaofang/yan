# Dense matrix multiply and transpose on list[list[int]].

def mul(a: list[list[int]], b: list[list[int]]) -> list[list[int]]:
    n = a.len()
    m = b[0].len()
    k = b.len()
    out: list[list[int]] = []
    for i in range(n):
        row: list[int] = []
        for j in range(m):
            s = 0
            for t in range(k):
                s += a[i][t] * b[t][j]
            row.append(s)
        out.append(row)
    return out

def transpose(a: list[list[int]]) -> list[list[int]]:
    return [[row[j] for row in a] for j in range(a[0].len())]

def main() uses io:
    a = [[1, 2, 3], [4, 5, 6]]
    b = transpose(a)
    io.print(f"{b}")
    io.print(f"{mul(a, b)}")
    ident = [[1, 0], [0, 1]]
    io.print(f"{mul(ident, mul(a, b)) == mul(a, b)}")
