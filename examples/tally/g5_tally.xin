"""Tally slice: authorize card payments, charge fees, settle per merchant."""

type Mcc = Grocery() | Travel() | Other(code: int)

type Decision = Approved(code: str) | Declined(reason: str)

class Auth:
    id: int
    merchant: str
    pan: str
    minor: int
    mcc: Mcc

class Settled:
    merchant: str
    gross: int
    fees: int
    net: int

trait Acquirer:
    def send(self: Self, pan: str, minor: int) -> Decision: ...

class FakeAcquirer:
    limit: int

impl Acquirer for FakeAcquirer:
    def send(self: Self, pan: str, minor: int) -> Decision:
        if minor > self.limit:
            return Declined(reason="limit")
        if pan.startswith("4000"):
            return Declined(reason="issuer")
        return Approved(code="A" + str(minor % 97))

def bps(mcc: Mcc) -> int uses none:
    match mcc:
        case Grocery():
            return 150
        case Travel():
            return 250
        case Other(_):
            return 290

pub def fee(minor: int, mcc: Mcc) -> int uses none:
    """Interchange fee in minor units, rounded down."""
    pre minor >= 0
    post out >= 0
    post out <= minor
    ex fee(10000, Grocery()) == 150
    ex fee(10000, Other(code=5999)) == 290
    return minor * bps(mcc) // 10000

pub def luhn(pan: str) -> bool uses none:
    """Checks the Luhn digit of a card number."""
    ex luhn("4242424242424242") == True
    ex luhn("4242424242424241") == False
    digits: list[int] = pan.chars().map(lambda c: str(c).parse_int() else -1).collect()
    total = 0
    double = False
    for d in reversed(digits):
        if d < 0:
            return False
        v = d
        if double:
            v = v * 2
            if v > 9:
                v = v - 9
        total += v
        double = not double
    return total % 10 == 0

pub def authorize[A: Acquirer](acq: A, a: Auth) -> Decision uses none:
    """Rejects bad card numbers and amounts locally, then asks the acquirer."""
    ex authorize(FakeAcquirer(limit=10), Auth(id=1, merchant="m", pan="4242424242424241", minor=5, mcc=Grocery())) == Declined(reason="luhn")
    if a.minor <= 0:
        return Declined(reason="amount")
    if not luhn(a.pan):
        return Declined(reason="luhn")
    return acq.send(a.pan, a.minor)

def approved(d: Decision) -> bool uses none:
    match d:
        case Approved(_):
            return True
        case Declined(_):
            return False

pub def settle(auths: list[Auth], ds: list[Decision]) -> list[Settled] uses none:
    """Nets approved authorizations per merchant, in first-seen order."""
    pre len(auths) == len(ds)
    ex settle([], []) == []
    acc: dict[str, Settled] = {}
    for a, d in zip(auths, ds):
        if approved(d):
            s = acc.get(a.merchant) else Settled(merchant=a.merchant.copy(), gross=0, fees=0, net=0)
            f = fee(a.minor, a.mcc)
            acc[a.merchant.copy()] = Settled(merchant=a.merchant.copy(), gross=s.gross + a.minor, fees=s.fees + f, net=s.net + a.minor - f)
    return acc.values()

pub def main() uses io:
    auths = [
        Auth(id=1, merchant="corner-shop", pan="4242424242424242", minor=1250, mcc=Grocery()),
        Auth(id=2, merchant="air-lines", pan="378282246310005", minor=48000, mcc=Travel()),
        Auth(id=3, merchant="corner-shop", pan="4242424242424241", minor=900, mcc=Grocery()),
        Auth(id=4, merchant="air-lines", pan="5555555555554444", minor=150000, mcc=Travel()),
        Auth(id=5, merchant="corner-shop", pan="5555555555554444", minor=3999, mcc=Grocery()),
        Auth(id=6, merchant="bookstore", pan="4242424242424242", minor=0, mcc=Other(code=5942)),
        Auth(id=7, merchant="bookstore", pan="4000056655665556", minor=2500, mcc=Other(code=5942)),
        Auth(id=8, merchant="bookstore", pan="4242424242424242", minor=2500, mcc=Other(code=5942)),
    ]
    acq = FakeAcquirer(limit=100000)
    ds = auths.map(lambda a: authorize(acq, a))
    for a, d in zip(auths, ds):
        match d:
            case Approved(code):
                io.print(f"{a.id} approved {code}")
            case Declined(reason):
                io.print(f"{a.id} declined {reason}")
    for s in settle(auths, ds):
        io.print(f"{s.merchant} gross={s.gross} fees={s.fees} net={s.net}")

def test_declined_never_settles():
    auths = [Auth(id=1, merchant="m", pan="4242424242424242", minor=100, mcc=Grocery())]
    assert settle(auths, [Declined(reason="limit")]) == []

def test_net_is_gross_minus_fees():
    auths = [Auth(id=1, merchant="m", pan="4242424242424242", minor=10000, mcc=Travel())]
    s = settle(auths, [Approved(code="A")])
    assert s == [Settled(merchant="m", gross=10000, fees=250, net=9750)]
