def apply(f: Callable[[], str]) -> str uses none:
    return f()

def stash(f: Callable[[], str]) -> Callable[[], str] uses none:
    return f

def pace(f: Callable[[], None]) -> None uses none:
    f()

pub def main() uses io, fs, time:
    io.print(apply(lambda: fs.read("x") else "x"))
    g = stash(lambda: fs.read("y") else "y")
    io.print(g())
    pace(lambda: time.sleep(1 * s) else e -> None)
