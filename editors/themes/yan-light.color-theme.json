  "colors": {
    "editor.background": "#F3F1EC",
    "editor.foreground": "#141518",
    "editorCursor.foreground": "#C8341F",
    "editorLineNumber.foreground": "#6A6D75",
    "editorLineNumber.activeForeground": "#141518",
    "editor.selectionBackground": "#D6D2C8",
    "editorWidget.background": "#ECE9E2",
    "editorError.foreground": "#B8301C",
    "editorWarning.foreground": "#8F5A0B",
    "editorInfo.foreground": "#3D4FA8",
    "focusBorder": "#C8341F",
    "button.background": "#C8341F",
    "button.foreground": "#F3F1EC",
    "sideBar.background": "#ECE9E2",
    "panel.border": "#D6D2C8",
    "terminal.background": "#F3F1EC",
    "terminal.foreground": "#141518",
    "terminal.ansiBlack": "#141518",
    "terminal.ansiBrightBlack": "#101013",
    "terminal.ansiRed": "#C8341F",
    "terminal.ansiBrightRed": "#9C2918",
    "terminal.ansiGreen": "#2A7253",
    "terminal.ansiBrightGreen": "#215941",
    "terminal.ansiYellow": "#8F5A0B",
    "terminal.ansiBrightYellow": "#704609",
    "terminal.ansiBlue": "#3D4FA8",
    "terminal.ansiBrightBlue": "#303E83",
    "terminal.ansiMagenta": "#7A3E9D",
    "terminal.ansiBrightMagenta": "#5F307A",
    "terminal.ansiCyan": "#1F6F78",
    "terminal.ansiBrightCyan": "#18575E",
    "terminal.ansiWhite": "#ECE9E2",
    "terminal.ansiBrightWhite": "#B8B6B0"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6A6D75",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword, storage",
      "settings": {
        "foreground": "#3D4FA8"
      }
    },
    {
      "scope": "entity.name.type, support.type",
      "settings": {
        "foreground": "#7A3E9D"
      }
    },
    {
      "scope": "string, constant.character",
      "settings": {
        "foreground": "#2A7253"
      }
    },
    {
      "scope": "constant.numeric, constant.language",
      "settings": {
        "foreground": "#8F5A0B"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#141518"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#B8301C"
      }
    }
  ]
}
