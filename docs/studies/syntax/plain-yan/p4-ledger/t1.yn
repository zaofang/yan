type Quote = { sym: str, px: float }

type PortErr = MissingQuote(sym: str) | Fetch(msg: str)

fetch_quote(sym: str) -> Quote fail PortErr uses net =
  let body = net.get_text("https://px.example/\(sym)")?
  let px = json.parse_float(body) else fail Fetch(msg: "bad price: \(sym)")
  Quote(sym: copy sym, px: px)

pub quotes(syms: List[str]) -> List[Quote] fail PortErr | Timeout uses net, clock =
  with timeout(2s)
    let qs = par (limit: 8) for s in syms
      fetch_quote(s)?
    return qs
