type Account = { id: int, balance: int }

type TransferErr = Insufficient(need: int) | NoAccount(id: int)

pub fn transfer(var book: Map[int, Account], src: int, dst: int, amt: int) fail TransferErr uses none =
  pre amt > 0
  let account = book.get(src) else fail NoAccount(id: src)
  if account.balance < amt
    fail Insufficient(need: amt - account.balance)
  if dst not in book
    fail NoAccount(id: dst)
  book[src].balance -= amt
  book[dst].balance += amt

fn pay_rent(var book: Map[int, Account]) =
  try transfer(&book, src: 1, dst: 2, amt: 1200)
