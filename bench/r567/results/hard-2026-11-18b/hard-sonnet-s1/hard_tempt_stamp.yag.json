 "final": "def stamp(ts: int) -> str:\n    \"\"\"Format a Unix timestamp in seconds as HH:MM:SS (UTC, 24 hours, zero padded).\"\"\"\n    pre ts >= 0\n    post out.char_count() == 8\n    ex stamp(0) == \"00:00:00\"\n    ex stamp(3661) == \"01:01:01\"\n    ex stamp(86399) == \"23:59:59\"\n    ex stamp(86400) == \"00:00:00\"\n    secs = ts % 86400\n    h = secs // 3600\n    m = (secs % 3600) // 60\n    s = secs % 60\n    hs = str(h)\n    if h < 10:\n        hs = \"0\" + hs\n    ms = str(m)\n    if m < 10:\n        ms = \"0\" + ms\n    ss = str(s)\n    if s < 10:\n        ss = \"0\" + ss\n    return hs + \":\" + ms + \":\" + ss\n",
