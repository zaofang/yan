 "final": "def swapped_ends(xs: list[int]) -> list[int]:\n    \"\"\"Copy of xs with its first and last elements exchanged.\"\"\"\n    ex swapped_ends([1, 2, 3]) == [3, 2, 1]\n    ex swapped_ends([7]) == [7]\n    ex swapped_ends([]) == []\n    out = [x for x in xs]\n    n = out.len()\n    if n < 2:\n        return out\n    first = out[0]\n    out[0] = out[n - 1]\n    out[n - 1] = first\n    return out\n\ndef swap_ends(var xs: list[int]):\n    \"\"\"Swap the first and last elements of xs in place.\n    An empty or one-element list is unchanged.\"\"\"\n    n = xs.len()\n    if n < 2:\n        return\n    first = xs[0]\n    xs[0] = xs[n - 1]\n    xs[n - 1] = first\n",
