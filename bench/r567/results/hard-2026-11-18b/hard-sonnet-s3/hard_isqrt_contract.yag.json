 "final": "def isqrt(n: int) -> int:\n    \"\"\"Largest r with r*r <= n, for n >= 0.\"\"\"\n    pre n >= 0\n    post out >= 0 and out * out <= n and n // (out + 1) < out + 1\n    ex isqrt(0) == 0\n    ex isqrt(1) == 1\n    ex isqrt(15) == 3\n    ex isqrt(16) == 4\n    lo = 0\n    hi = n\n    while lo < hi:\n        mid = lo + (hi - lo + 1) // 2\n        if mid <= n // mid:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo\n",
