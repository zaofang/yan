 "final": "def pick(xs: list[int], seed: int) -> int:\n    \"\"\"Return the element of xs at index seed modulo xs.len(). The same xs and seed always give the same element.\"\"\"\n    pre xs.len() > 0\n    post out in xs\n    ex pick([5], 123) == 5\n    ex pick([1, 2, 3], 4) == 2\n    ex pick([10, 20, 30], 3) == 10\n    ex pick([7], -5) == 7\n    n = xs.len()\n    i = seed % n\n    if i < 0:\n        i += n\n    return xs[i]\n",
