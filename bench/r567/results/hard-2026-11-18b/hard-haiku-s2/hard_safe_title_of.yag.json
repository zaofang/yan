 "final": "def title_of(html: str) -> str:\n    \"\"\"Return the text between the first <title> and </title> in html, or an empty string if either tag is missing.\"\"\"\n    post out.char_count() <= html.char_count()\n    ex title_of(\"<html><title>Hi</title></html>\") == \"Hi\"\n    ex title_of(\"<p>no title</p>\") == \"\"\n    ex title_of(\"<title>  A  </title>\") == \"  A  \"\n    before, opened, rest = html.partition(\"<title>\")\n    if opened == \"\":\n        return \"\"\n    text, closed, after = rest.partition(\"</title>\")\n    if closed == \"\":\n        return \"\"\n    return text\n",
