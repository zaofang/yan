 "final": "def pick(xs: list[int], seed: int) -> int:\n    \"\"\"Return the element at index seed modulo the length of xs.\n\n    The index is always taken non-negative, so the same seed always selects\n    the same element and no randomness is used.\n    \"\"\"\n    pre xs.len() > 0\n    post out in xs\n    ex pick([10, 20, 30], 0) == 10\n    ex pick([10, 20, 30], 4) == 20\n    ex pick([10, 20, 30], -1) == 30\n    idx = seed % xs.len()\n    return xs[idx]\n",
