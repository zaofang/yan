 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids, deterministic for a given seed.\n\n    The same (n, seed) always gives the same list. It uses no capabilities,\n    so there is no clock, randomness or I/O. Any seed is allowed.\n    \"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(0, 7) == []\n    ex make_ids(3, 1).len() == 3\n    ex make_ids(4, 42) == make_ids(4, 42)\n    base = (seed % 1000003) * 1000\n    ids: list[int] = []\n    for i in range(n):\n        ids.append(base + i)\n    return ids\n",
