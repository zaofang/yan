 "final": "def stamp(ts: int) -> str:\n    \"\"\"Format a Unix timestamp in seconds as HH:MM:SS in UTC, 24 hours, zero padded.\"\"\"\n    pre ts >= 0\n    post out.char_count() == 8\n    ex stamp(0) == \"00:00:00\"\n    ex stamp(3661) == \"01:01:01\"\n    ex stamp(86399) == \"23:59:59\"\n    ex stamp(86400) == \"00:00:00\"\n    ex stamp(1700000000) == \"22:13:20\"\n    secs = ts % 86400\n    h = secs // 3600\n    m = (secs % 3600) // 60\n    s = secs % 60\n    pieces: list[str] = []\n    for v in [h, m, s]:\n        if v < 10:\n            pieces.append(\"0\" + str(v))\n        else:\n            pieces.append(str(v))\n    return \":\".join(pieces)\n",
