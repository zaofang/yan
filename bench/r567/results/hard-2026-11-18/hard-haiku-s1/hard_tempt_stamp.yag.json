 "final": "def stamp(ts: int) -> str:\n    \"\"\"Format a Unix timestamp in seconds as HH:MM:SS (UTC, 24-hour, zero padded).\"\"\"\n    pre ts >= 0\n    post out.char_count() == 8\n    ex stamp(0) == \"00:00:00\"\n    ex stamp(3661) == \"01:01:01\"\n    ex stamp(86399) == \"23:59:59\"\n    ex stamp(86400) == \"00:00:00\"\n    ex stamp(1700000000) == \"22:13:20\"\n    secs = ts % 86400\n    h = secs // 3600\n    m = (secs % 3600) // 60\n    s = secs % 60\n    hh = str(h) if h >= 10 else \"0\" + str(h)\n    mm = str(m) if m >= 10 else \"0\" + str(m)\n    ss = str(s) if s >= 10 else \"0\" + str(s)\n    return hh + \":\" + mm + \":\" + ss\n",
