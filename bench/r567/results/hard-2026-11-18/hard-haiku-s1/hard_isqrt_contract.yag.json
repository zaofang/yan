 "final": "def isqrt(n: int) -> int:\n    \"\"\"Largest r with r * r <= n, for n >= 0.\"\"\"\n    pre n >= 0\n    post out * out <= n and (out + 1) * (out + 1) > n\n    ex isqrt(0) == 0\n    ex isqrt(15) == 3\n    ex isqrt(16) == 4\n    m = n\n    r = 0\n    bit = 1 << 62\n    while bit > m:\n        bit = bit >> 2\n    while bit != 0:\n        if m >= r + bit:\n            m = m - (r + bit)\n            r = (r >> 1) + bit\n        else:\n            r = r >> 1\n        bit = bit >> 2\n    return r\n",
