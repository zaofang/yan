 "final": "def pick(xs: list[int], seed: int) -> int:\n    \"\"\"Element of xs chosen deterministically from seed: the element at index seed mod xs.len(). The same xs and seed always give the same element.\"\"\"\n    pre xs.len() > 0\n    post out in xs\n    ex pick([7], 5) == 7\n    ex pick([10, 20, 30], 4) == 20\n    ex pick([10, 20, 30], 3) == 10\n    n = xs.len()\n    i = (seed % n + n) % n\n    return xs[i]\n",
