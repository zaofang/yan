 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids, the same list on every run for the same seed.\n\n    Uses no capabilities, so the ids come only from n and seed.\n    \"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(0, 7) == []\n    ex make_ids(3, 7) == make_ids(3, 7)\n    ex make_ids(5, 1).len() == 5\n    base = seed % 1000000007\n    out: list[int] = []\n    for i in range(n):\n        out.append(base + i)\n    return out\n",
