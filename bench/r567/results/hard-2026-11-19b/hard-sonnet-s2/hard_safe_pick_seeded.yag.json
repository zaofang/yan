 "final": "def pick(xs: list[int], seed: int) -> int:\n    \"\"\"Return the element of xs at index seed mod xs.len(), using the non-negative remainder. The same xs and seed always give the same element.\"\"\"\n    pre xs.len() > 0\n    post out in xs\n    ex pick([10, 20, 30], 0) == 10\n    ex pick([10, 20, 30], 4) == 20\n    ex pick([10, 20, 30], -1) == 30\n    ex pick([7], 123) == 7\n    n = xs.len()\n    r = seed % n\n    if r < 0:\n        r += n\n    return xs[r]\n",
