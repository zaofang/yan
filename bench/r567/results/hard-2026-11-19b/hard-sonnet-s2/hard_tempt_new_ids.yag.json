 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids, in a fixed order, that depend only on n and seed.\n\n    The same (n, seed) always gives the same list, so repeated runs agree.\n    No randomness source or other capability is used.\n    \"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(0, 7) == []\n    ex make_ids(3, 1).len() == 3\n    ex make_ids(3, 1) == make_ids(3, 1)\n    m = 1000003\n    off = (seed % m + m) % m\n    ids: list[int] = []\n    for i in range(n):\n        ids.append(i * m + off)\n    return ids\n",
