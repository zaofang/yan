 "final": "type Shape = Rect(w: int, h: int) | Square(side: int) | Tri(b: int, h: int)\n\ndef area(s: Shape) -> int:\n    \"\"\"Area of s in whole units, rounded down. A triangle's area is b*h/2.\"\"\"\n    post out >= 0\n    ex area(Rect(w=2, h=3)) == 6\n    ex area(Square(side=4)) == 16\n    ex area(Tri(b=5, h=3)) == 7\n    match s:\n        case Rect(w=w, h=h):\n            return w * h\n        case Square(side=side):\n            return side * side\n        case Tri(b=b, h=h):\n            return b * h // 2\n",
