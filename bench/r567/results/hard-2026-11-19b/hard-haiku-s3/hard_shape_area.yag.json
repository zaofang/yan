 "final": "type Shape = Rect(w: int, h: int) | Square(side: int) | Tri(b: int, h: int)\n\ndef area(s: Shape) -> int:\n    \"\"\"Area of a shape in whole square units, rounded down.\n\n    A rectangle is w*h, a square is side*side, and a triangle is b*h/2\n    rounded down.\n    \"\"\"\n    post out >= 0\n    ex area(Rect(w=3, h=4)) == 12\n    ex area(Square(side=5)) == 25\n    ex area(Tri(b=3, h=5)) == 7\n    match s:\n        case Rect(w=w, h=h):\n            return w * h\n        case Square(side=n):\n            return n * n\n        case Tri(b=b, h=h):\n            return b * h // 2\n",
