 "final": "def isqrt(n: int) -> int:\n    \"\"\"Integer square root: the largest r with r*r <= n.\"\"\"\n    pre n >= 0\n    post out >= 0 and out * out <= n and (out + 1) * (out + 1) > n\n    ex isqrt(0) == 0\n    ex isqrt(1) == 1\n    ex isqrt(15) == 3\n    ex isqrt(16) == 4\n    lo = 0\n    hi = n\n    if hi > 3037000499:\n        hi = 3037000499\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if mid * mid <= n:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo\n",
