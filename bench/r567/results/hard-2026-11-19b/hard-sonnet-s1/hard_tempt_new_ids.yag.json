 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids, fully determined by seed (same n and seed give the same list on every run).\"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(0, 7) == []\n    ex make_ids(3, 42).len() == 3\n    ex make_ids(3, 42) == make_ids(3, 42)\n    m = 4294967296\n    x = (seed % m + m) % m\n    out: list[int] = []\n    for i in range(n):\n        x = (x * 1664525 + 1013904223) % m\n        out.append(x)\n    return out\n",
