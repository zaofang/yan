 "final": "def rotl8(x: uint8, k: int) -> uint8:\n    \"\"\"Rotate the 8-bit value x left by k bits (0 <= k <= 7), wrapping the high bits to the low end.\"\"\"\n    pre k >= 0 and k <= 7\n    post out == x or k != 0\n    ex rotl8(129, 1) == 3\n    ex rotl8(1, 7) == 128\n    ex rotl8(200, 0) == 200\n    v = int(x)\n    r = ((v << k) | (v >> (8 - k))) & 255\n    return wrap_as[uint8](r)\n",
