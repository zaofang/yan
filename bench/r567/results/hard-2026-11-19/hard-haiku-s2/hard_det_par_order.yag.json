 "final": "def parity(x: int) -> int:\n    \"\"\"Return 0 for even x and 1 for odd x.\"\"\"\n    ex parity(3) == 1\n    ex parity(4) == 0\n    ex parity(-3) == 1\n    return x % 2\n\ndef parities(xs: list[int]) -> list[int]:\n    \"\"\"Return the parity of each element of xs, computed in parallel.\n\n    The result keeps input order and does not depend on the thread count.\n    \"\"\"\n    post out.len() == xs.len()\n    post all([out[i] == parity(xs[i]) for i in range(xs.len())])\n    ex parities([1, 2, 3]) == [1, 0, 1]\n    ex parities([]) == []\n    ex parities([7, 7, 8]) == [1, 1, 0]\n    return par [parity(x) for x in xs]\n",
