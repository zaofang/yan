 "final": "def title_of(html: str) -> str:\n    \"\"\"Return the text between the first <title> and </title> in html, or an empty string when no complete title element exists.\"\"\"\n    pre html.char_count() >= 0\n    post out.char_count() <= html.char_count()\n    ex title_of(\"<html><title>Hi</title></html>\") == \"Hi\"\n    ex title_of(\"<p>no title</p>\") == \"\"\n    ex title_of(\"<title>  A  </title>\") == \"  A  \"\n    before, open_sep, after_open = html.partition(\"<title>\")\n    if open_sep == \"\":\n        return \"\"\n    body, close_sep, after_close = after_open.partition(\"</title>\")\n    if close_sep == \"\":\n        return \"\"\n    return body\n",
