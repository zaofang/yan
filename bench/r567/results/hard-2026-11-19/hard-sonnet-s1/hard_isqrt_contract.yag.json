 "final": "def isqrt(n: int) -> int:\n    \"\"\"Integer square root: the largest r with r*r <= n.\"\"\"\n    pre n >= 0\n    post out >= 0 and out * out <= n and (out + 1) * (out + 1) > n\n    ex isqrt(0) == 0\n    ex isqrt(1) == 1\n    ex isqrt(15) == 3\n    ex isqrt(16) == 4\n    lo = 0\n    hi = 3037000500\n    while hi - lo > 1:\n        mid = (lo + hi) // 2\n        if mid * mid <= n:\n            lo = mid\n        else:\n            hi = mid\n    return lo\n",
