 "final": "def stamp(ts: int) -> str:\n    \"\"\"Format a Unix timestamp in seconds as HH:MM:SS in UTC, 24 hours, zero padded. The day is discarded, so the time wraps every 86400 seconds.\"\"\"\n    pre ts >= 0\n    post out.char_count() == 8\n    ex stamp(0) == \"00:00:00\"\n    ex stamp(59) == \"00:00:59\"\n    ex stamp(3661) == \"01:01:01\"\n    ex stamp(86399) == \"23:59:59\"\n    ex stamp(86400) == \"00:00:00\"\n    ex stamp(1700000000) == \"22:13:20\"\n    secs = ts % 86400\n    h = secs // 3600\n    m = (secs % 3600) // 60\n    s = secs % 60\n    return f\"{h // 10}{h % 10}:{m // 10}{m % 10}:{s // 10}{s % 10}\"\n",
