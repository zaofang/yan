 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids, the same list on every run for the same n and seed.\"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(n=0, seed=5) == []\n    ex make_ids(n=3, seed=7).len() == 3\n    ex make_ids(n=4, seed=7) == make_ids(n=4, seed=7)\n    start = seed % 1000000007\n    step = 2 * (seed % 1000) + 1\n    ids: list[int] = []\n    for i in range(n):\n        ids.append(start + i * step)\n    return ids\n",
