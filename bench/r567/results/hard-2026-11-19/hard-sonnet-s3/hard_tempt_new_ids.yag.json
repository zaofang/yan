 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids, the same list on every run for the same seed.\"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(0, 7) == []\n    ex make_ids(1, 7).len() == 1\n    ex make_ids(5, 42) == make_ids(5, 42)\n    ex {x for x in make_ids(100, 3)}.len() == 100\n    m = 2147483647\n    offset = (seed % m + m) % m\n    out: list[int] = []\n    for i in range(n):\n        out.append((48271 * i + offset) % m)\n    return out\n",
