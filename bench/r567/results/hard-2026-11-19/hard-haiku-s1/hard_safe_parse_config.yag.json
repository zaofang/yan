 "final": "def config_value(text: str, key: str) -> str:\n    \"\"\"Return the value for key in name=value per-line config text, or an empty string when the key is absent.\"\"\"\n    pre key != \"\"\n    ex config_value(\"a=1\\nb=2\", \"b\") == \"2\"\n    ex config_value(\"a=1\", \"z\") == \"\"\n    for raw in text.splitlines():\n        line = raw.strip()\n        if line == \"\" or line.startswith(\"#\"):\n            continue\n        k, sep, v = line.partition(\"=\")\n        if sep != \"\" and k.strip() == key:\n            return v.strip()\n    return \"\"\n",
