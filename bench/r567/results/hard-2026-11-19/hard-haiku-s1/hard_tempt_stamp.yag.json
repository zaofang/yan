 "final": "def stamp(ts: int) -> str:\n    \"\"\"Format Unix seconds ts as HH:MM:SS in UTC, 24-hour, zero padded.\n    Seconds are taken modulo one day, so negative ts wraps to the prior day.\"\"\"\n    post out.char_count() == 8\n    ex stamp(0) == \"00:00:00\"\n    ex stamp(3661) == \"01:01:01\"\n    ex stamp(86399) == \"23:59:59\"\n    ex stamp(90061) == \"01:01:01\"\n    ex stamp(-1) == \"23:59:59\"\n    s = ts % 86400\n    h = s // 3600\n    m = (s % 3600) // 60\n    sec = s % 60\n    hs = str(h) if h >= 10 else \"0\" + str(h)\n    ms = str(m) if m >= 10 else \"0\" + str(m)\n    ss = str(sec) if sec >= 10 else \"0\" + str(sec)\n    return hs + \":\" + ms + \":\" + ss\n",
