 "final": "def make_ids(n: int, seed: int) -> list[int]:\n    \"\"\"Return n distinct record ids. The same seed always gives the same ids.\"\"\"\n    pre n >= 0\n    post out.len() == n\n    post {x for x in out}.len() == n\n    ex make_ids(0, 5) == []\n    ex make_ids(3, 7) == make_ids(3, 7)\n    ex make_ids(3, 7).len() == 3\n    base = seed % 1000000007\n    return [i * 1000000007 + base for i in range(n)]\n",
