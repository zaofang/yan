def is_prime(n: int) -> bool:
    """True if n is a prime number."""
    ex is_prime(1) == False
    ex is_prime(13) == True
    ex is_prime(15) == False
    # ---
    if n < 2:
        return False
    k = 2
    while k * k <= n:
        if n % k == 0:
            return False
        k += 1
    return True
