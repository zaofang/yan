-- spec: 4.4, 4.3
-- rows: R457
-- note: the read checks; the assignment uses the inout mode, which cannot write through a View; the span is the yielded place
-- expect: E423 at 12:11

type Point = { x: int, y: int }

type Window = { p: View[Point] }

impl Index[int] for Window
  sub at(self, k: int) -> int =
    yield self.p.x

f(p: Point) -> int =
  var w = Window(p: p)
  let a = w[0]
  w[0] = a + 1
  a
