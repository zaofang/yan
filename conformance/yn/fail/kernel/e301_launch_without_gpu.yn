-- spec: 7.1, 17.1
-- rows: R971
-- note: a launch is a `gpu` operation (#880)
-- expect: E301 at 14:3

@kernel(tile: 2, 2)
@access(a: elementwise, out: elementwise)
inc(at: TileOrigin, a: Array[2, 4, int]) -> Array[2, 4, int] =
  for i in range(0, 2)
    for j in range(0, 2)
      out[at.i0 + i, at.i1 + j] = a[at.i0 + i, at.i1 + j] * 10 + at.i1

f(a: Array[2, 4, int]) -> Array[2, 4, int] fail KernelFault =
  gpu.launch(inc, a)?

main() = 0
