-- spec: 11.2
-- rows: R954
-- note: a product of two variables is not affine (#845)
-- expect: E274 at 11:35

@kernel(tile: 8, 8)
@access(a: elementwise, out: elementwise)
scale(at: TileOrigin, a: Array[64, 64, float]) -> Array[64, 64, float] =
  for i in range(0, 8)
    for j in range(0, 8)
      out[at.i0 + i, at.i1 + j] = a[at.i0 * at.i1, at.i1 + j]

main() = 0
