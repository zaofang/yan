-- spec: 4.4, 10.3
-- rows: R457
-- note: one sub serves the read (let) and the assignment and augmented assignment (inout) modes

type Counter = { hits: int, misses: int }

impl Index[bool] for Counter
  sub at(self, k: bool) -> int =
    if k
      yield self.hits
    else
      yield self.misses

f() -> int =
  var c = Counter(hits: 0, misses: 0)
  c[True] = 2
  c[False] += 1
  c[True] + c[False]

type Box = { a: int, b: int }

impl Index[int] for Box
  sub at(self, k: int) -> int =
    let j = k + 1
    if j > 2
      yield self.a
    else
      yield self.b

g() -> int =
  var c = Box(a: 4, b: 1)
  let x = c[1]
  x + 1
