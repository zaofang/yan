-- spec: 6.2, 6.3, 15
-- rows: R1039
-- note: get_mut is a place on an owned mutex with no lock and no capability; into_inner moves the value out
-- stdout:
-- 1
-- [1, 2]

main() uses io =
  var m = Mutex[int](1)
  io.print("\(m.get_mut)")
  var n = Mutex[list[int]]([1])
  n.get_mut.append(2)
  io.print("\(n.into_inner())")
