-- spec: 6.9
-- rows: R1098
-- note: a value queued on a channel that holds its own receiver is never released, so the machine reports it
-- ub: none
-- warn: W862

type Link = { rx: Receiver[Link], s: str }

main() fail Cancelled uses nondet =
  let (tx, rx) = Channel[Link](1)
  var t = tx
  t.send(Link(rx, "abc".upper()))?
