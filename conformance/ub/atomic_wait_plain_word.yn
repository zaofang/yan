-- spec: 6.2, 6.7
-- rows: R1097
-- note: a word the program only accessed with plain loads and stores is not atomic storage for `Atomic.wait`
-- ub: 15

type Slot = { a: Atomic[u32] }

main() fail Cancelled | Timeout uses nondet =
  var w: u64 = 0
  var raw = Ptr.of(&w).addr()
  let q = Ptr.of(&raw).cast[Slot]()
  unsafe
    let s = q.read()
    s.a.wait(0, LoadOrdering.Acquire())?
