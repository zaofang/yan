-- spec: 6.7, 6.8, 6.9
-- note: proposed by RFC 0076 D5; the second call breaks the pre while its access stays in bounds, so only item 16 applies (assumption A11)
-- ub: 16

unsafe get(p: Ptr[int], i: int, n: int) -> int =
  pre 0 <= i and i < n
  unsafe
    p.offset(i).read()

main() =
  let xs = [1, 2]
  unsafe
    assert get(xs.as_ptr(), 1, 2) == 2
    assert get(xs.as_ptr(), 1, 1) == 2
