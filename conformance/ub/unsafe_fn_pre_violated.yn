-- spec: 6.7, 6.8, 6.9
-- rows: R1014
-- note: RFC 0076 D5; the second call breaks the pre while its access stays in bounds, so only item 16 applies (assumption A11)
-- ub: 16

unsafe get(p: Ptr[int], i: int, n: int) -> int =
  pre 0 <= i and i < n
  var r = 0
  unsafe
    r = p.offset(i).read()
  r

main() =
  let xs = [1, 2]
  unsafe
    assert get(xs.as_ptr(), i: 1, n: 2) == 2
    assert get(xs.as_ptr(), i: 1, n: 1) == 2
