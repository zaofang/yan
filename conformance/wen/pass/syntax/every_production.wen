-- spec: 15.2
-- rows: R266, R370, R374, R433, R437, R444

--- Touches the Wen productions of 15.2 that L0 to L3 programs use.

use std.text as text

type Point = { x: int, y: int = 0 }
type V2 = { x: float, y: float, / }
type Shape = Circle(r: float) | Rect(w: float, h: float) | Dot()
type Meters = newtype[float]
type Names = List[str]
type Svc = uses io, log
type Bad = { msg: str }

let limit: int = 10

trait Area
  type Unit
  area(self) -> float
  twice(self) -> float = self.area() * 2.0

impl Area for Point
  type Unit = float
  area(self) -> float = 0.0

@inline
pos(a: int, b: int, /, c: int = 1) -> int =
  pre a >= 0
  post out >= a
  ex pos(1, 2) == 3
  a + c * 0 + (if b > 0 then b else 0)

first[T: Eq](xs: List[T]) -> T? =
  if xs.len() == 0
    return None
  xs[0]

parse(s: str) -> int fail Bad = s.parse_int() else fail Bad(msg: copy s)

check(s: str) fail Bad =
  let n = parse(s)?
  if n < 0
    fail Bad(msg: "negative")

head(xs: View[int]) -> View[int] from xs = xs

bump(var n: int, take xs: List[int]) =
  n += xs.len()

report(n: int) uses Svc =
  io.print("n = \(n:>4)")
  log.info(t"n = {n}")

describe(s: Shape) -> str =
  match s
    Circle(r) if r > 1.0 -> "big circle"
    Circle(r:) -> "circle \(r)"
    Rect(w:, h:) if w == h -> "square"
    Rect(..) -> "rect"
    Dot() -> "dot"

classify(n: int) -> str =
  0 -> "zero"
  1..=9 -> "small"
  _ -> "big"

loops(xs: List[int]) -> int =
  var total = 0
  var i = 0
  outer: while i < xs.len()
    invariant i >= 0
    i += 1
    if i == 3
      continue outer
    else if i > 100
      break outer
  for x in xs
    total += x
  loop
    break
  total

guard(d: Map[str, int], k: str) -> int fail Bad =
  let a = d.get(k) else 0
  let b = d.get(k) else return 0
  let c = d.get(k) else err -> 1
  let Ok(e) = try parse(k) else
    fail Bad(msg: "missing")
  a + b + c + e

numbers(a: int) -> int =
  let c = (a | 1) ^ (a & 2)
  let d = (a << 2) >> 1
  let f = a as i32
  let g = a ** 2 + -a
  c + d + (f as int) + g + a // 3

concurrency(xs: List[int]) -> List[int] =
  par
    let a = xs.len()
    let b = 2
  let ys = par for x in xs
    x * a + b
  ys

lambdas(xs: List[Point]) -> List[int] = xs.map(.x).map(n -> n + 1)

tail(n: int, acc: int) -> int =
  pre n >= 0
  decreases n
  if n == 0
    return acc
  become tail(n - 1, acc + 1)

copies(xs: List[int]) -> int =
  let ys = copy xs
  let r = try parse("1")
  let ok = r is Ok(_)
  ys.len() + (if ok then 1 else 0)

test_pos() =
  assert pos(1, 2) == 3
