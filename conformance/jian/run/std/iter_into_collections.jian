# spec: 17.3
# rows: R511
# stdout:
# {30, 10, 20} 3
# {3: 2, 1: 1, 2: 3}
# [2, 3, 3] [3, 3, 2, 1]
# {3, 1, 2}

pub def main() uses io:
    xs = [3, 1, 3, 2]
    s = set(xs.iter().map(lambda x: x * 10))
    io.print(f"{s} {s.len()}")
    d = dict(xs.iter().enumerate().map(lambda p: (p[1], p[0])))
    io.print(f"{d}")
    io.print(f"{sorted(xs.iter().filter(lambda x: x > 1))} {sorted(xs, key=lambda x: -x)}")
    io.print(f"{set(xs)}")
