# spec: 17.3
# rows: R489, R492
# stdout:
# (10, 'a') (40, 'd')
# (20, 'b') (20, 'b') None
# (30, 'c') (30, 'c') None
# [(20, 'b'), (30, 'c')] []
# (40, 'd')
# (30, 'c')
# (20, 'b')
# (10, 'a')
# sorted_dict({}) None

pub def main() uses io:
    m = sorted_dict({10: "a", 20: "b", 30: "c", 40: "d"})
    io.print(f"{m.first()} {m.last()}")
    io.print(f"{m.floor(25)} {m.floor(20)} {m.floor(5)}")
    io.print(f"{m.ceiling(25)} {m.ceiling(30)} {m.ceiling(45)}")
    io.print(f"{m.range(15, 40)} {m.range(40, 15)}")
    while True:
        e = m.pop_last() else break
        io.print(f"{e}")
    io.print(f"{m} {m.pop_first()}")
