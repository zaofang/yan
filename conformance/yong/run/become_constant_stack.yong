-- spec: 3.5
-- rows: R260
-- note: the reference interpreter must not grow its stack (3.5)
-- stdout:

module conf.become_constant_stack

fn count(let n: i64, let acc: i64) -> i64
    requires ge_i64(let n, let 0)
    decreases n
{
    let z: bool = eq_i64(let n, let 0)
    if z { ret acc }
    let m: i64 = sub_checked_i64(let n, let 1)
    let a: i64 = add_checked_i64(let acc, let 1)
    become count(let m, let a)
}

fn main() -> Unit {
    let r: i64 = count(let 10000000, let 0)
    assert eq_i64(let r, let 10000000)
    ret ()
}
