-- spec: 4.2
-- rows: R963, R964
-- note: a `break` after the move leaves no back edge from it (#861)

module conf.loop_move_then_break

fn keep(sink xs: List[i64]) -> i64 {
    ret 0
}

fn f(sink xs: List[i64]) -> i64 {
    loop 'l {
        let n: i64 = keep(sink xs)
        break 'l
    }
    ret 0
}
