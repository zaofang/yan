case-d5 ::= "                    " "case" ws pattern ("if" ws expr)? ":" ws block-d5
case-d6 ::= "                        " "case" ws pattern ("if" ws expr)? ":" ws block-d6
case-d7 ::= "                            " "case" ws pattern ("if" ws expr)? ":" ws block-d7
case-d8 ::= "                                " "case" ws pattern ("if" ws expr)? ":" ws block-d8
withstmt-d0 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d0
withstmt-d1 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d1
withstmt-d2 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d2
withstmt-d3 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d3
withstmt-d4 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d4
withstmt-d5 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d5
withstmt-d6 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d6
withstmt-d7 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d7
withstmt-d8 ::= "with" ws (expr "as" sp name ws | name ws "=" ws expr | "deadline" ws "(" ws expr ")" ws | "timeout" ws "(" ws expr ")" ws | "shield" ws "(" ws expr ")" ws | "supervisor" ws "(" ws expr ")" ws) ":" ws block-d8
parstmt-d0 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d1 (stmt-d1)* | "for" ws target "in" ws expr ":" ws lbody-d0)
parstmt-d1 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d2 (stmt-d2)* | "for" ws target "in" ws expr ":" ws lbody-d1)
parstmt-d2 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d3 (stmt-d3)* | "for" ws target "in" ws expr ":" ws lbody-d2)
parstmt-d3 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d4 (stmt-d4)* | "for" ws target "in" ws expr ":" ws lbody-d3)
parstmt-d4 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d5 (stmt-d5)* | "for" ws target "in" ws expr ":" ws lbody-d4)
parstmt-d5 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d6 (stmt-d6)* | "for" ws target "in" ws expr ":" ws lbody-d5)
parstmt-d6 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d7 (stmt-d7)* | "for" ws target "in" ws expr ":" ws lbody-d6)
parstmt-d7 ::= "par" ws ("concurrent")? ("(" ws "limit" ws "=" ws expr ")" ws)? (":" ws nl stmt-d8 (stmt-d8)* | "for" ws target "in" ws expr ":" ws lbody-d7)
block-d0 ::= (simple nl | nl stmt-d1 (stmt-d1)*)
block-d1 ::= (simple nl | nl stmt-d2 (stmt-d2)*)
block-d2 ::= (simple nl | nl stmt-d3 (stmt-d3)*)
block-d3 ::= (simple nl | nl stmt-d4 (stmt-d4)*)
block-d4 ::= (simple nl | nl stmt-d5 (stmt-d5)*)
block-d5 ::= (simple nl | nl stmt-d6 (stmt-d6)*)
block-d6 ::= (simple nl | nl stmt-d7 (stmt-d7)*)
block-d7 ::= (simple nl | nl stmt-d8 (stmt-d8)*)
block-d8 ::= (simple nl)
pattern ::= patone ("as" sp name ws)*
patone ::= ("_" | literal | path ("(" ws (parg ("," ws parg)*)? ")" ws)? | "(" ws pattern "," ws pattern ("," ws pattern)* ")" ws)
parg ::= (pattern | name ws "=" ws pattern)
expr ::= (lambda | fallback)
lambda ::= "lambda" ws (name ws ("," ws name ws)*)? ":" ws expr
fallback ::= cond ("else" ws (name ws "->" ws cond | cond | "return" ws (cond)? | "fail" ws cond | "break" | "continue"))?
cond ::= disj ("if" ws disj "else" ws cond)?
disj ::= conj ("or" ws conj)*
conj ::= neg ("and" ws neg)*
neg ::= ("not" ws neg | comp)
comp ::= bitor (compop bitor)?
compop ::= ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" sp "in" ws | "is" ws ("not")?)
bitor ::= bitxor ("|" ws bitxor)*
bitxor ::= bitand ("^" ws bitand)*
bitand ::= shift ("&" ws shift)*
shift ::= arith (("<<" | ">>") arith)*
arith ::= term (("+" | "-") term)*
term ::= unary (("*" | "/" | "//" | "%" | "@") unary)*
unary ::= (("-" | "+" | "~") unary | power)
power ::= postfix ("**" ws unary)?
postfix ::= atom (("." ws (name | typename) | "(" ws (args)? ")" ws | "[" ws (expr | slice) "]" ws | "?"))*
args ::= arg ("," ws arg)* (",")?
arg ::= (expr | "&" ws place | "become" ws postfix | (name | typename) "=" ws ("&" ws place | "become" ws postfix | expr))
place ::= name ws (("." ws name ws | "[" ws expr "]" ws))*
atom ::= (literal | fstring | name | typename | "_" | "..." | "(" ws expr ")" ws | "(" ws expr "," ws (expr ("," ws expr)* (",")?)? ")" ws | "[" ws (expr ("," ws expr)* (",")?)? "]" ws | "{" ws (kv ("," ws kv)* (",")?)? "}" ws | "{" ws expr ("," ws expr)* (",")? "}" ws | comprehension | "par" ws ("concurrent")? comprehension | "fail" ws unary)
comprehension ::= ("[" ws expr "for" ws target "in" ws disj ("if" ws disj)? "]" ws | "{" ws kv "for" ws target "in" ws disj ("if" ws disj)? "}" ws | "{" ws expr "for" ws target "in" ws disj ("if" ws disj)? "}" ws)
kv ::= expr ":" ws expr
slice ::= (expr)? ":" ws (expr)? (":" ws (expr)?)?
literal ::= (int | float | string | bytes | char | "True" | "False" | "None")
fstring ::= (fstring | tstring)
type ::= base ("|" ws "None" ws)?
base ::= (scalar | "str" | "bytes" | "char" | "bigint" | "decimal" | "None" | "list" ws "[" ws type "]" ws | "dict" ws "[" ws type "," ws type "]" ws | "set" ws "[" ws type "]" ws | "deque" ws "[" ws type "]" ws | "heap" ws "[" ws type "]" ws | "sorted_dict" ws "[" ws type "," ws type "]" ws | "sorted_set" ws "[" ws type "]" ws | "soa" ws "[" ws type "]" ws | "tuple" ws "[" ws type ("," ws type)* "]" ws | "Result" ws "[" ws type "," ws errtype "]" ws | "View" ws "[" ws type "]" ws | "MutView" ws "[" ws type "]" ws | "StrView" | "Array" ws "[" ws atarg ("," ws atarg)* "]" ws | "Table" ws "[" ws type "]" ws | "Quantity" ws "[" ws type "," ws dim "]" ws | ("par")? "Callable" ws "[" ws "[" ws (type ("," ws type)*)? "]" ws "," ws type (callsfx)? "]" ws | path ("[" ws (type | int) ("," ws (type | int))* "]" ws)?)
scalar ::= ("int" | "float" | "bool" | "int8" | "int16" | "int32" | "int128" | "uint8" | "uint16" | "uint32" | "uint64" | "uint128" | "float16" | "bfloat16" | "float32" | "float128")
errtype ::= base ("|" ws base)*
callsfx ::= "," ws ("fail" ws "(" ws errtype ")" ws ("," ws "uses" ws "(" ws name ws ("," ws name ws)* ")" ws)? | "uses" ws "(" ws name ws ("," ws name ws)* ")" ws)
atarg ::= (int | type)
path ::= (name | typename) (ptail)?
ptail ::= "." ws (name ws (ptail)? | typename)
dim ::= name ws (("*" | "/") name ws)* ("**" ws int ws)?

ws ::= " "*
sp ::= " "+
nl ::= "\n"
name ::= [a-z] [a-z0-9]* ("_" [a-z0-9]+)* | "_"
typename ::= [A-Z] [a-z0-9]* ([A-Z] [a-z0-9]*)*
digits ::= [0-9] ("_"? [0-9])*
int ::= "0x" [0-9a-fA-F_]+ | "0o" [0-7_]+ | "0b" [01_]+ | digits
float ::= digits "." digits? exp? | digits exp | "." digits exp?
exp ::= [eE] [+-]? digits
strbody ::= ([^"\\\n] | "\\" [^\n])*
string ::= "r"? "\"" strbody "\"" | "c\"" strbody "\"" | "r"? "\"\"\"" tqbody "\"\"\""
tqbody ::= ([^"\\] | "\\" . | "\"" [^"] | "\"\"" [^"])*
bytes ::= "b\"" strbody "\""
char ::= "c'" ([^'\\\n] | "\\" [^\n]) "'"
fbody ::= ([^"\\{}\n] | "\\" [^\n] | "{{" | "}}" | "{" [^{}\n]+ "}")*
fstring ::= "f\"" fbody "\""
tstring ::= "t\"" fbody "\""
