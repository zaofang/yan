# 2 3

class Cache:
    vals: dict[str, int]
    hits: int

def put(var c: Cache, k: str, v: int):
    c.vals[k.copy()] = v

def main() uses io:
    c = Cache(vals={}, hits=0)
    put(&c, "a", 1)
    put(&c, "b", 2)
    put(&c, "a", 3)
    io.print(f"{c.vals.len()} {c.vals.get('a')}")
