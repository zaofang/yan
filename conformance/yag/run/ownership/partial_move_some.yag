# spec: 4.1, 4.2
# rows: R1
# note: the binder of a Some pattern over a record moves one field and frees the rest (#1500 item 3)
# stdout:
# X
# none
class P:
    s: str
    xs: list[int]

def f(take o: P | None) -> str:
    match o:
        case Some(p):
            return p.s
        case None:
            return "none"

def main() uses io:
    io.print(f(P(s="x".upper(), xs=[1])))
    io.print(f(None))
