# spec: 4.1, 4.2
# rows: R1
# note: a field moved out of a fresh record on each iteration frees the remainder every time (#1500 item 3)
# stdout:
# 0A1
# 1B1
# 2C1
class H:
    s: str
    xs: list[int]

def eat(take s: str) -> str:
    return s

def main() uses io:
    names = ["a", "b", "c"]
    for i in range(3):
        h = H(s=names[i].upper(), xs=[1])
        s = eat(h.s)
        io.print(f"{i}{s}{h.xs.len()}")
