# spec: 17.4
# rows: R687
# note: a Secret shows as Secret(***), exposes its value and compares by value
# stdout:
# Secret(***) hunter2 True None
# [Secret(***)]

pub def main() uses io:
    with env = fake_env(vars={"TOKEN": "hunter2"}):
        s = env.secret("TOKEN") else Secret("none")
        missing = env.secret("NOPE")
        io.print(f"{s} {s.expose()} {s == Secret('hunter2')} {missing}")
        io.print(f"{[s]}")
