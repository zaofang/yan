# spec: 17.3
# rows: R681
# note: counts, rotations, swaps and shifts agree on every fixed-width integer type at its edge values
# stdout:
# int8 -128: 1 0 7 8 -128 1 False
#   rot 4 16 64 16 shl 0 shr -1
# int8 22: 3 3 1 5 22 104 False
#   rot -80 -62 11 -62 shl 0 shr 0
# int8 127: 7 1 0 7 127 -2 False
#   rot -5 -17 -65 -17 shl -128 shr 0
