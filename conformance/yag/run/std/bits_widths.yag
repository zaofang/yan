    x: uint64 = 3
    io.print(f"uint64 3: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 69)} shl {bits.wrapping_shl(x, 63)} shr {x >> 63}")
    x: uint64 = 18446744073709551615
    io.print(f"uint64 18446744073709551615: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
