# int64 -9223372036854775808: 1 0 63 64 128 1 False
#   rot 4 1152921504606846976 4611686018427387904 16 shl 0 shr -1
# int64 3: 2 62 0 2 216172782113783808 -4611686018427387904 False
#   rot 24 6917529027641081856 -9223372036854775807 96 shl -9223372036854775808 shr 0
#   4611686018427387904
# uint64 3: 2 62 0 2 216172782113783808 13835058055282163712 False
#   rot 24 6917529027641081856 9223372036854775809 96 shl 9223372036854775808 shr 0
