#   4611686018427387904

pub def main() uses io:
    x: int8 = -128
    io.print(f"int8 -128: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 13)} shl {bits.wrapping_shl(x, 7)} shr {x >> 7}")
    x: int8 = 22
    io.print(f"int8 22: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 13)} shl {bits.wrapping_shl(x, 7)} shr {x >> 7}")
    x: int8 = 127
    io.print(f"int8 127: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 13)} shl {bits.wrapping_shl(x, 7)} shr {x >> 7}")
    one: int8 = 1
    io.print(f"  {one << 6}")
    x: uint8 = 0
    io.print(f"uint8 0: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 13)} shl {bits.wrapping_shl(x, 7)} shr {x >> 7}")
    x: uint8 = 22
    io.print(f"uint8 22: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 13)} shl {bits.wrapping_shl(x, 7)} shr {x >> 7}")
    x: uint8 = 255
    io.print(f"uint8 255: {bits.count_ones(x)} {bits.leading_zeros(x)} {bits.trailing_zeros(x)} {bits.bit_width(x)} {bits.swap_bytes(x)} {bits.reverse_bits(x)} {bits.is_power_of_two(x)}")
    io.print(f"  rot {bits.rotate_left(x, 3)} {bits.rotate_right(x, 3)} {bits.rotate_left(x, -1)} {bits.rotate_left(x, 13)} shl {bits.wrapping_shl(x, 7)} shr {x >> 7}")
    one: uint8 = 1
    io.print(f"  {one << 6}")
