# spec: 17.3
# note: a generic function whose parameter is named like the callee's binds the callee's type argument from a list[T] argument (#1442)
# stdout:
# True
# False
# [1, 3]

def rm[T: Eq](var xs: list[T], x: T) -> bool:
    i = xs.index(x) else return False
    _ = xs.remove_at(i)
    return True

def main() uses io:
    a = [1, 2, 3]
    io.print(f"{rm(&a, 2)}")
    io.print(f"{rm(&a, 9)}")
    io.print(f"{a}")
