# spec: 17.3
# rows: R1022
# note: remove_at takes a negative index from the end; remove drops the first equal element; clear empties
# stdout:
# 2 [1, 3, 4]
# 4 [1, 3]
# [1]
# 0

def main() uses io:
    xs = [1, 2, 3, 4]
    io.print(f"{xs.remove_at(1)} {xs}")
    io.print(f"{xs.remove_at(-1)} {xs}")
    xs.remove(3)
    io.print(f"{xs}")
    ws = ["a", "b"]
    ws.clear()
    io.print(f"{ws.len()}")
