# 2
# [hi]
# [hi]
# x
# x
# x
# ab   |
# ***ab
# ab
# -00042
# +007
# 00042
# 3
# 0

pub def main() uses io:
    io.print(str("abcabc".rfind("bc")))
    io.print(str("abc".rfind("z")))
    io.print(str("aé".rfind("")))
    io.print("[" + "  hi".lstrip() + "]")
    io.print("[" + "hi  ".rstrip() + "]")
    io.print("test_x".removeprefix("test_"))
    io.print("x.py".removesuffix(".py"))
    io.print("x".removesuffix(""))
    io.print("ab".ljust(5) + "|")
    io.print("ab".rjust(5, "*"))
    io.print("ab".rjust(1))
    io.print("-42".zfill(6))
    io.print("+7".zfill(4))
    io.print("42".zfill(5))
    io.print(str([1, 2, 1, 1].count(1)))
    io.print(str(["a"].count("b")))
