# spec: 17.3
# rows: R1029
# note: sign, zero pad, width, grouping and .Nf follow CPython; 2.675 rounds on its exact binary value
# stdout:
# 3.14|0007|2.67|-0|1,234,567.89|+7|   3.142|-00003.1|1,234,567|    7|3.1      |

def main() uses io:
    x = 3.14159
    n = 7
    io.print(f"{x:.2f}|{n:04}|{2.675:.2f}|{-0.5:.0f}|{1234567.891:,.2f}|{n:+}|{x:8.3f}|{-x:08.1f}|{1234567:,}|{n:>5}|{x:<9.1f}|")
