# spec: 17.3
# rows: R488, R489, R493
# stdout:
# deque([1, 2, 3]) 3
# 1 3 3
# 1 3
# True False True
# 24
# 3 1 deque([20])
# deque([]) -1

pub def main() uses io:
    d: deque[int] = deque()
    d.append(2)
    d.append(3)
    d.appendleft(1)
    io.print(f"{d} {len(d)}")
    io.print(f"{d[0]} {d[2]} {d[-1]}")
    d[1] = 20
    io.print(f"{d.first() else -1} {d.last() else -1}")
    io.print(f"{20 in d} {5 in d} {5 not in d}")
    total = 0
    for x in d:
        total += x
    io.print(f"{total}")
    io.print(f"{d.pop()} {d.popleft()} {d}")
    e: deque[int] = deque()
    io.print(f"{e} {e.first() else -1}")
