# spec: 10.1, 13
# rows: R423
# stdout:
# hi!
# none
# True
# Just(value=['x', 'y'])
# Just(value=Just(value=3))
# P(a='k', b=Just(value='v'))
# kv

type Maybe[T] = Just(value: T) | Nothing()
type Pair[A, B] = P(a: A, b: B)

def show_m(m: Maybe[str]) -> str:
    match m:
        case Just(value=v):
            return v + "!"
        case Nothing():
            return "none"

pub def main() uses io:
    a: Maybe[str] = Just(value="hi")
    b: Maybe[list[str]] = Just(value=["x", "y"])
    c: Maybe[Maybe[int]] = Just(value=Just(value=3))
    p: Pair[str, Maybe[str]] = P(a="k", b=Just(value="v"))
    io.print(show_m(a))
    io.print(show_m(Nothing()))
    io.print(a == Just(value="hi"))
    io.print(b)
    io.print(c)
    io.print(p)
    match p:
        case P(a=x, b=Just(value=y)):
            io.print(x + y)
        case _:
            io.print("no")
