class P:
    """A point.

    Attributes:
        x: the x
    """
    x: int
    "the x again"

def f(a: int) -> int:
    """Does f.

    :param a: the a
    :type a: int
    """
    return a

pub def main() uses io:
    io.print(f"{f(P(1).x)}")
