# spec: 14.4
# rows: R1008
# note: N53 reads s.len() and the free calls char_count, parse_int, to_string, to_int, slice and byte_at as their method or operator spellings
# stdout:
# 3 3 12 7 7 [2, 3] 98

def main() uses io:
    s = "abc"
    k = parse_int("12") else 0
    xs = [1, 2, 3, 4]
    io.print(f"{s.len()} {char_count(s)} {k} {to_int(' 7 ')} {to_string(7)} {slice(xs, 1, 3)} {byte_at(s, 1)}")
