# spec: 9.6
# rows: R397
# note: another task's handler runs while a `@reentrant` handler of the same actor waits on `recv`, and the waiting handler sees its update (#835)
# stdout:
# 11
# 111
# 111

class A:
    n: int

def bump(var self: A, k: int) -> int:
    self.n += k
    return self.n

@reentrant
def wait_for(var self: A, var rx: Receiver[int]) -> int fail ActorError:
    self.n += 1
    v = rx.recv()? else 0
    self.n += v
    return self.n

def poke(a: Actor[A], var tx: Sender[int]) -> int:
    b = a.bump(10) else -1
    tx.send(100) else e -> None
    return b

def main() uses io:
    a = actor.spawn(A(n=0))
    tx, rx = Channel[int](1)
    par concurrent:
        print(a.wait_for(&rx) else e -> -1)
        print(poke(a, &tx))
    print(a.bump(0) else -1)
