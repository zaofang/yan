# spec: 9.4, 9.6
# rows: R811
# note: an actor call made inside a shield inherits the shield's deadline, not the 5 s default
# stdout:
# Timeout() after PT1S
# 7

class A:
    n: int

def get(var self: A) -> int:
    return self.n

def hold(var self: A, var rx: Receiver[int]) -> int fail Cancelled | Timeout:
    return rx.recv()? else 0

def show(r: Result[int, ActorError]) -> str:
    match r:
        case Ok(v):
            return f"{v}"
        case Err(e):
            return f"{e}"

def ask(a: Actor[A], var go: Receiver[int]) -> str fail Timeout | ShieldTimeout uses time, shield:
    go.recv() else e -> 0
    t0 = time.monotonic()
    with shield(1 * s):
        r = show(a.get())
    return f"{r} after {time.monotonic() - t0}"

def main() uses io, time, shield:
    with time = virtual(time.now()):
        with sched = sequential():
            a = actor.spawn(A(n=0))
            tx, rx = Channel[int](1)
            go_tx, go_rx = Channel[int](1)
            par concurrent:
                for _ in range(1):
                    print(ask(a, &go_rx) else e -> "t")
                    tx.send(7) else e -> None
                print(a.hold(&rx) else e -> -1)
                go_tx.send(1) else e -> None
