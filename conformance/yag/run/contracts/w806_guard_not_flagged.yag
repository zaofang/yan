# spec: 21.1
# rows: R1095
# note: a guard whose result the rest of the body already produces is not special-casing
# stdout:
# False True

def valid(s: str) -> bool:
    ex valid("") == False
    ex valid("a") == True
    if s == "":
        return False
    return s.char_count() > 0

def main() uses io:
    empty = valid("")
    some = valid("a")
    io.print(f"{empty} {some}")
