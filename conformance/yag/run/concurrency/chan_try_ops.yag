# spec: 9.5
# rows: R342
# note: try_recv returns TryRecv[T]: Got on a value, Empty on an open empty channel, Closed once every sender is gone; try_send fails Full[T] carrying the unsent value (#1153, #1257, #1264)
# stdout:
# Empty()
# sent
# Full(value=2)
# Got(value=1)
# Empty()
# Got(value=0)
# Closed()

def gone() -> Receiver[int] uses nondet:
    tx, rx = Channel[int](1)
    tx.try_send(0) else e -> None
    return rx

def poll(var rx: Receiver[int]) -> str fail Cancelled uses nondet:
    return f"{rx.try_recv()?}"

def push(var tx: Sender[int], v: int) -> str fail Full[int] | Cancelled uses nondet:
    tx.try_send(v)?
    return "sent"

def main() uses io, nondet:
    tx, rx = Channel[int](1)
    print(poll(&rx) else e -> f"{e}")
    print(push(&tx, 1) else e -> f"{e}")
    print(push(&tx, 2) else e -> f"{e}")
    print(poll(&rx) else e -> f"{e}")
    print(poll(&rx) else e -> f"{e}")
    r = gone()
    print(poll(&r) else e -> f"{e}")
    print(poll(&r) else e -> f"{e}")
