# spec: 6.3
# rows: R1038
# note: try_lock is matched in place; the Some arm holds the guard and unlocks at its end, so a later lock does not deadlock; a mutex held by the caller gives None and no panic
# stdout:
# got 5
# held
# 7

def main() uses io, nondet:
    m = Mutex[int](5)
    match m.try_lock():
        case None:
            print("none")
        case g:
            print(f"got {g.get()}")
    h = m.lock()
    match m.try_lock():
        case None:
            print("held")
        case g:
            print("unexpected")
    h.set(7)
    print(h.get())
