# spec: 9.4
# rows: R394
# note: both branches leave by `fail` or `?` after a rendezvous; the channel ends owned by the enclosing frame are dropped once (#900)
# stdout:
# Bad(n=-1)
# Bad(n=2)

@derive(Show)
class Bad:
    n: int

def boom(n: int) -> None fail Bad:
    if n > 0:
        fail Bad(n=n)

def by_fail() -> str fail Bad:
    tx, rx = Channel[int](0)
    par concurrent:
        for i in range(1):
            v = (rx.recv() else e -> -1) else -1
            fail Bad(n=v)
        for j in range(1):
            tx.send(5) else e -> None
            fail Bad(n=2)
    return "ok"

def by_propagate() -> str fail Bad:
    tx, rx = Channel[int](0)
    par concurrent:
        for i in range(1):
            v = (rx.recv() else e -> -1) else -1
            boom(v)?
        for j in range(1):
            tx.send(5) else e -> None
            boom(2)?
    return "ok"

pub def main() uses io:
    io.print(by_fail() else err -> f"{err}")
    io.print(by_propagate() else err -> f"{err}")
