# spec: 6.2
# rows: R1100
# note: notify_all releases every task parked on the word
# stdout:
# 111

def waiter(a: Atomic[uint32], n: Atomic[uint32]) -> None fail Cancelled | Timeout uses nondet:
    a.wait(0, LoadOrdering.Acquire())?
    _ = n.fetch_add(1, Ordering.SeqCst())

def waker(a: Atomic[uint32]) -> None uses nondet:
    a.store(1, StoreOrdering.Release())
    a.notify_all()

def main() -> None fail Cancelled | Timeout uses io, nondet:
    a = Atomic[uint32](0)
    n = Atomic[uint32](0)
    with sched = sequential():
        par concurrent:
            waiter(a, n)?
            waiter(a, n)?
            waiter(a, n)?
            waker(a)
    print(n.load(LoadOrdering.SeqCst()) * 37)
