# spec: 5.2
# stdout:
# 5 17
# 2 17
# 9 1000
# 9 255

@layout(bits(u8))
class Flags:
    a: uint3
    b: uint5

@layout(bits(u16))
class Wide:
    a: uint4
    b: uint12

pub def main() uses io:
    f = Flags(a=5, b=17)
    io.print(f"{f.a} {f.b}")
    n: uint3 = 2
    f.a = n
    io.print(f"{f.a} {f.b}")
    w = Wide(a=9, b=1000)
    io.print(f"{w.a} {w.b}")
    m: uint12 = 255
    w.b = m
    io.print(f"{w.a} {w.b}")
