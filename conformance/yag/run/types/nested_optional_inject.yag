# spec: 14.1
# rows: R793, R794, R795
# milestone: M1b
# note: MaybeInt | None is Option[int | None] because an alias never flattens; returning a MaybeInt wraps it in Some once, so a stored None is not the outer None
# stdout:
# True True
# True

type MaybeInt = int | None

def lookup(v: MaybeInt) -> MaybeInt | None:
    return v

pub def main() uses io:
    a = lookup(None)
    b = lookup(7)
    io.print(f"{a is not None} {b is not None}")
    if a is not None:
        io.print(f"{a is None}")
