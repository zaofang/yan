# spec: 13.2
# rows: R423, R427, R431, R452
# note: names unused by design are parameters of documented examples; warnings are allowed in pass/

"""Touches every Yan Agent production of 13.2 at least once."""

class Point:
    """A point."""
    x: int
    y: int = 0

class Empty:
    pass

type Shape = Circle(r: float) | Rect(w: float, h: float) | Dot()
type Meters = newtype[float]
type Names = list[str]
type Svc = uses io, log

trait Area:
    type Unit
    def area(self: Self) -> float: ...

impl Area for Point:
    type Unit = float
    def area(self: Point) -> float:
        return 0.0

limit: int = 10

class Bad:
    msg: str

@inline
def pos(a: int, b: int, /, c: int = 1) -> int:
    """Positional-only parameters, a default."""
    pre a >= 0
    post out >= a
    ex pos(1, 2) == 3
    return a + b * 0 + c * 0 + (b if b > 0 else 0)

def fixed[n: int](x: int) -> int:
    return x + n

def first[T: Eq](xs: list[T]) -> T | None:
    if len(xs) == 0:
        return None
    return xs[0]

def parse(s: str) -> int fail Bad:
    return s.parse_int() else fail Bad(msg=s.copy())

def check(s: str) -> fail Bad:
    n = parse(s)?
    if n < 0:
        fail Bad(msg="negative")

def head(xs: View[int]) -> View[int] from xs:
    return xs

def bump(var n: int, take xs: list[int]) -> None:
    n += len(xs)

def report(n: int) uses Svc:
    io.print(f"n = {n:>4}")
    log.info(t"n = {n}")

def describe(s: Shape) -> str:
    match s:
        case Circle(r) if r > 1.0:
            return "big circle"
        case Circle(r=r):
            return f"circle {r}"
        case Rect(w, h) as whole:
            return "rect"
        case Dot():
            return "dot"

def loops(xs: list[int]) -> int:
    total = 0
    i = 0
    while i < len(xs):
        invariant i >= 0
        i += 1
        if i == 3:
            continue
        elif i > 100:
            break
        else:
            pass
    for j, x in enumerate(xs):
        total += x * j
    return total

def literals() -> list[int]:
    a = 0x1F + 0o7 + 0b101 + 1_000
    f = 1.5e3
    s = r"raw\n" + """triple""" + "plain"
    b = b"bytes"
    ch = c'a'
    ok = True and not False
    sq = [x * x for x in range(3) if x != 1]
    st = {x for x in range(3)}
    dm = {k: k + 1 for k in range(3)}
    tp = (1, "a")
    sl = sq[0:2:1]
    assert len(sl) <= 2
    return [a, s.byte_len(), len(b), len(st), len(dm), tp[0], int(f), 1 if ok else 0] + sq

def ops(a: int, b: int) -> int:
    c = (a | b) ^ (a & b)
    d = (a << 2) >> 1
    e = ~a
    g = a ** 2 + -b
    h = a // 3 + (a % 3)
    return c + d + e + g + h

def fallback(d: dict[str, int], k: str) -> int fail Bad:
    a = d.get(k) else 0
    c = d.get(k) else fail Bad(msg="missing")
    return a + c

def concurrency(xs: list[int]) -> list[int]:
    par:
        a = len(xs)
        b = 2
    ys = par [x * a + b for x in xs]
    par(limit=2) for y in ys:
        assert y >= 0
    return ys

def handlers() -> int fail Timeout uses time:
    with deadline(time.monotonic() + 1 * s):
        pass
    with timeout(5 * s):
        pass
    return 0

def tail(n: int, acc: int) -> int:
    pre n >= 0
    decreases n
    if n == 0:
        return acc
    become tail(n - 1, acc + 1)

def lambdas(xs: list[int]) -> list[int]:
    return xs.map(lambda x: x + 1)

def test_pos():
    assert pos(1, 2) == 3
