# spec: 4, 7.2
# rows: R1025
# note: a copy of a closure holds the capabilities the closure captures
# expect: E301 at 12:20

def apply(f: Callable[[], str]) -> str uses none:
    return f()

pub def main() -> None uses io, fs:
    g: Callable[[], str] = lambda: fs.read("x") else "x"
    h = g
    io.print(apply(h))
