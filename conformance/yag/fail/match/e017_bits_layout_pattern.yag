# spec: 5.2
# note: a pattern on a bits-layout record is refused, never run as an ordinary record
# expect: E017 at 12:5

@layout(bits(u8))
class Flags:
    a: uint3
    b: uint5

pub def main() uses io:
    f = Flags(a=5, b=17)
    match f:
        case Flags(a=x, b=y):
            io.print(f"{x} {y}")
