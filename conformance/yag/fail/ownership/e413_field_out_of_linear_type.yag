# spec: 4.2, 5.4
# rows: R1084
# expect: E413 at 23:14
# note: a non-linear field moved out of a `@linear` record is rejected; only its linear fields may leave (#1573 item 2)

@linear
class Inner:
    id: int

@linear
class Outer:
    inner: Inner
    label: str

def eat(take s: str) -> str:
    return s

def close(take i: Inner) -> int:
    return i.id

def main() -> None uses io:
    o = Outer(inner=Inner(id=1), label="x".upper())
    io.print(eat(o.label))
    io.print(str(close(o.inner)))
