# spec: 6.4
# rows: R1060
# note: an Rc declared outside the par is checked by type in each branch, even when no branch names the same binding twice
# expect: E417 at 12:18
# expect: E417 at 13:18

def peek(_: Rc[int]) -> int:
    return 1

def f(a: Rc[int], b: Rc[int]) -> int:
    par:
        x = peek(a)
        y = peek(b)
    return x + y
