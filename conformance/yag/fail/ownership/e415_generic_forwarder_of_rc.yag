# spec: 6.4
# note: a generic function that sends a value of its type parameter is checked at each instantiation
# expect: W863 at 7:5
# expect: E415 at 10:5

def fwd[T](var tx: Sender[T], v: T) -> None fail Cancelled:
    tx.send(v)?

def send_rc(var tx: Sender[Rc[int]], v: Rc[int]) -> None fail Cancelled:
    fwd(&tx, v.share())?
