# spec: 4.5, 6.3
# rows: R1037
# note: a guard is a view for escape analysis: it cannot be stored in a record or a container
# expect: E414 at 14:18
# expect: E414 at 18:11
# expect: W812 at 14:5
# expect: W812 at 18:5

class Holder:
    g: MutexGuard[int]

def store(m: Mutex[int]) -> None:
    g = m.lock()
    h = Holder(g=g)

def collect(m: Mutex[int]) -> None:
    g = m.lock()
    gs = [g]
