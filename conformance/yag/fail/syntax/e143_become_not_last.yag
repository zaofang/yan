# note: 13.2 has become only as a statement; R456 says Yan Agent spells the constructor form the same way (grammar question G1)
# expect: E143 at 13:17

type Tree = Leaf() | Node(left: Tree, right: Tree)

def spine(n: int) -> Tree:
    pre n >= 0
    decreases n
    if n == 0:
        return Leaf()
    return Node(become spine(n - 1), Leaf())
