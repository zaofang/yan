# spec: 9.6.1
# rows: R407, R989
# note: a start placed with `On` must be `@remote`; the span is the start's name
# expect: E721 at 14:37

class Counter:
    n: int

def make(start: int) -> Counter:
    return Counter(n=start)

pub def main() -> None uses cluster:
    with cluster = sim(2, 1):
        _ = cluster.spawn(ChildSpec(make, (1,)), placement=On(cluster.self_node()))
