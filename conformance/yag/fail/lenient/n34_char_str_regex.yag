def digit(c: char) -> bool:
    return c.isdigit()

def upper(c: char) -> bool:
    return c.isupper()

def str_digit(s: str) -> bool:
    return s.is_digit()

def all_matches(p: Regex, s: str) -> list[Match]:
    return p.findall(s)

def whole(m: Match) -> str | None:
    return m.group()
