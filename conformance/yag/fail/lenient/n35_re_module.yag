def m(s: str) -> Match | None:
    return re.match("a+", s)

def f(s: str) -> Match | None:
    return re.search("b", s)

def r(s: str) -> str:
    return re.sub("a", "b", s)

def a(s: str) -> list[Match]:
    return re.findall("a", s)

def p(s: str) -> list[str]:
    return re.split(",", s)

def c() -> Regex:
    return re.compile("a+")
