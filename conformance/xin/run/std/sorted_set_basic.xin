# spec: 17.3
# rows: R488, R489, R492, R493
# stdout:
# sorted_set({3, 4, 5}) 3 True False
# sorted_set({3, 4, 5, 6}) sorted_set({4})
# 3
# 4
# 5
# None 3 [3, 4]
# 3 5 3 5 sorted_set({4})
# sorted_set() None

pub def main() uses io:
    s = sorted_set([5, 1, 3, 1])
    s.add(4)
    s.add(3)
    s.discard(1)
    s.discard(9)
    io.print(f"{s} {len(s)} {3 in s} {1 in s}")
    t = sorted_set([4, 6])
    io.print(f"{s.union(t)} {s.intersection(t)}")
    for x in s:
        io.print(f"{x}")
    io.print(f"{s.floor(2)} {s.ceiling(2)} {s.range(3, 5)}")
    io.print(f"{s.first()} {s.last()} {s.pop_first()} {s.pop_last()} {s}")
    e: sorted_set[str] = sorted_set()
    io.print(f"{e} {e.first()}")
