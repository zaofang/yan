# spec: 17.3
# note: below, range, bool, next_f64, choice and shuffle derive from next_u64 with fixed algorithms
# stdout:
# 1 -3 True 0.7231518528398883 [6, 5, 4, 3, 2, 1] 6
# 1 -3 True 0.7231518528398883 [6, 5, 4, 3, 2, 1] 6

def draws() -> str uses rand:
    a = rand.below(10)
    b = rand.range(-3, 3)
    c = rand.bool()
    f = rand.next_f64()
    xs = [1, 2, 3, 4, 5, 6]
    rand.shuffle(&xs)
    y = rand.choice(xs)
    return f"{a} {b} {c} {f} {xs} {y}"

pub def main() uses io:
    with rand = seeded(42):
        io.print(draws())
    with rand = seeded(42):
        io.print(draws())
