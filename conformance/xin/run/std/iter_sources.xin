# spec: 17.3
# rows: R509
# stdout:
# [7, 7, 7]
# [9]
# []
# [0, 0]
# [1, 3]
# ['a', 'b', 'c']

pub def main() uses io:
    io.print(f"{iter.repeat(7, n=3).collect()}")
    io.print(f"{iter.once(9).collect()}")
    e: iter[int] = iter.empty()
    io.print(f"{e.collect()}")
    io.print(f"{iter.repeat(0).take(2).collect()}")
    s: sorted_set[int] = sorted_set()
    s.add(3)
    s.add(1)
    io.print(f"{s.iter().collect()}")
    d = {"a": 1, "b": 2, "c": 3}
    io.print(f"{d.iter().collect()}")
