-- spec: 24.3, 16.5
-- note: proposed G5, the Wen twin of g5_tally.xin
-- stdout:
-- 1 approved A86
-- 2 approved A82
-- 3 declined luhn
-- 4 declined limit
-- 5 approved A22
-- 6 declined amount
-- 7 declined issuer
-- 8 approved A75
-- corner-shop gross=5249 fees=77 net=5172
-- air-lines gross=48000 fees=1200 net=46800
-- bookstore gross=2500 fees=72 net=2428

--- Tally slice: authorize card payments, charge fees, settle per merchant.

type Mcc = Grocery() | Travel() | Other(code: int)

type Decision = Approved(code: str) | Declined(reason: str)

type Auth = { id: int, merchant: str, pan: str, minor: int, mcc: Mcc }

type Settled = { merchant: str, gross: int, fees: int, net: int }

trait Acquirer
  send(self, pan: str, minor: int) -> Decision

type FakeAcquirer = { limit: int }

impl Acquirer for FakeAcquirer
  send(self, pan: str, minor: int) -> Decision =
    if minor > self.limit
      return Declined(reason: "limit")
    if pan.startswith("4000")
      return Declined(reason: "issuer")
    Approved(code: "A" + str(minor % 97))

bps(mcc: Mcc) -> int uses none =
  Grocery() -> 150
  Travel() -> 250
  Other(_) -> 290

--- Interchange fee in minor units, rounded down.
pub fee(minor: int, mcc: Mcc) -> int uses none =
  pre minor >= 0
  post out >= 0
  post out <= minor
  ex fee(10000, Grocery()) == 150
  ex fee(10000, Other(code: 5999)) == 290
  minor * bps(mcc) // 10000

--- Checks the Luhn digit of a card number.
pub luhn(pan: str) -> bool uses none =
  ex luhn("4242424242424242") == True
  ex luhn("4242424242424241") == False
  let digits: List[int] = pan.chars().map(c -> str(c).parse_int() else -1).collect()
  var total = 0
  var double = False
  for d in reversed(digits)
    if d < 0
      return False
    var v = d
    if double
      v = v * 2
      if v > 9
        v = v - 9
    total += v
    double = not double
  total % 10 == 0

--- Rejects bad card numbers and amounts locally, then asks the acquirer.
pub authorize[A: Acquirer](acq: A, a: Auth) -> Decision uses none =
  ex authorize(FakeAcquirer(limit: 10), Auth(id: 1, merchant: "m", pan: "4242424242424241", minor: 5, mcc: Grocery())) == Declined(reason: "luhn")
  if a.minor <= 0
    return Declined(reason: "amount")
  if not luhn(a.pan)
    return Declined(reason: "luhn")
  acq.send(a.pan, a.minor)

approved(d: Decision) -> bool uses none =
  Approved(_) -> True
  Declined(_) -> False

--- Nets approved authorizations per merchant, in first-seen order.
pub settle(auths: List[Auth], ds: List[Decision]) -> List[Settled] uses none =
  pre auths.len() == ds.len()
  ex settle([], []) == []
  var acc: Map[str, Settled] = {}
  for (a, d) in zip(auths, ds)
    if approved(d)
      let s = acc.get(a.merchant) else Settled(merchant: copy a.merchant, gross: 0, fees: 0, net: 0)
      let f = fee(a.minor, a.mcc)
      acc[copy a.merchant] = Settled(merchant: copy a.merchant, gross: s.gross + a.minor, fees: s.fees + f, net: s.net + a.minor - f)
  acc.values()

pub main() uses io =
  let auths = [
    Auth(id: 1, merchant: "corner-shop", pan: "4242424242424242", minor: 1250, mcc: Grocery()),
    Auth(id: 2, merchant: "air-lines", pan: "378282246310005", minor: 48000, mcc: Travel()),
    Auth(id: 3, merchant: "corner-shop", pan: "4242424242424241", minor: 900, mcc: Grocery()),
    Auth(id: 4, merchant: "air-lines", pan: "5555555555554444", minor: 150000, mcc: Travel()),
    Auth(id: 5, merchant: "corner-shop", pan: "5555555555554444", minor: 3999, mcc: Grocery()),
    Auth(id: 6, merchant: "bookstore", pan: "4242424242424242", minor: 0, mcc: Other(code: 5942)),
    Auth(id: 7, merchant: "bookstore", pan: "4000056655665556", minor: 2500, mcc: Other(code: 5942)),
    Auth(id: 8, merchant: "bookstore", pan: "4242424242424242", minor: 2500, mcc: Other(code: 5942)),
  ]
  let acq = FakeAcquirer(limit: 100000)
  let ds = auths.map(a -> authorize(acq, a))
  for (a, d) in zip(auths, ds)
    match d
      Approved(code) -> io.print("\(a.id) approved \(code)")
      Declined(reason) -> io.print("\(a.id) declined \(reason)")
  for s in settle(auths, ds)
    io.print("\(s.merchant) gross=\(s.gross) fees=\(s.fees) net=\(s.net)")

test_declined_never_settles() =
  let auths = [Auth(id: 1, merchant: "m", pan: "4242424242424242", minor: 100, mcc: Grocery())]
  assert settle(auths, [Declined(reason: "limit")]) == []

test_net_is_gross_minus_fees() =
  let auths = [Auth(id: 1, merchant: "m", pan: "4242424242424242", minor: 10000, mcc: Travel())]
  let s = settle(auths, [Approved(code: "A")])
  assert s == [Settled(merchant: "m", gross: 10000, fees: 250, net: 9750)]
