// Deployed by .github/workflows/site.yml after `tools.site build _site`.
{
  "name": "yanlang",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    // Every request, so browsers on plain http can be redirected; see worker.js.
    "run_worker_first": true
  },
  "routes": [{ "pattern": "yanlang.dev", "custom_domain": true }],
  "workers_dev": false
}
